{
  "name": "freeresizeimageonline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, unlimited, private in-browser image resizer",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run fonts",
    "dev": "astro dev",
    "prebuild": "npm test && npm run fonts && npm run ads-txt",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ads-txt": "node scripts/gen-ads-txt.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "astro": "^7.4.8",
    "fflate": "^0.8.3",
    "pica": "^10.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "@types/pica": "^9.0.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
