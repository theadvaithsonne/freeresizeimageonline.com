# Cloudflare Pages response headers.
# Note: no strict Content-Security-Policy on purpose. Google AdSense loads scripts, frames and images from
# many changing domains, and a strict policy would silently break ads. The resizer needs blob: workers
# (used by Pica and our encoder), which a CSP would also have to allow.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Hashed build files never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and images change rarely.
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# HTML: always check for a fresh copy (Cloudflare still serves it from the edge).
/*.html
  Cache-Control: public, max-age=0, must-revalidate
