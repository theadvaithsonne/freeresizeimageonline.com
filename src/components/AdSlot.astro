---
/**
 * Ad space.
 *
 * - variant="rail":   right-hand column on wide screens (>= 75rem). Sticky, 300x600 reserve.
 * - variant="inline": boxes in the content flow on phones/tablets (< 75rem): one after the how-to steps and one under the
 *                     results (inside the tool), each away from action buttons (Google ad placement policy).
 *
 * Only the rail or the inline boxes are visible at any width. The loader (Layout.astro) fills ONLY visible boxes,
 * because AdSense can't size an ad inside a display:none container.
 *
 * The Google <ins> element is created by the page script (see Layout.astro) only while its box is visible.
 *
 * Until an ad unit id is set in src/config/site.ts (after AdSense approval) NOTHING is rendered: no label and no empty
 * box over a non-ad. Once live, space is reserved with fixed heights, so the page never jumps.
 * Label wording is restricted by Google to "Advertisement" or "Sponsored Links".
 */
import { ADSENSE } from '../config/site';
import { t } from '../i18n';

interface Props {
  variant: 'rail' | 'inline';
  lang: string;
}
const { variant, lang } = Astro.props;
const label = t(lang, 'ads.label');
const slotId = ADSENSE.slots[variant];
const live = Boolean(ADSENSE.client && slotId);
---
{
  live && (
<aside class:list={['ad-slot', `ad-slot--${variant}`]} aria-label={label} data-ad-slot={variant}>
  <p class="ad-slot__label">{label}</p>
  <div class="ad-slot__box">
    <div
      class="ad-slot__unit"
      data-ad-unit
      data-client={ADSENSE.client}
      data-slot={slotId}
      data-format={variant === 'rail' ? 'vertical' : 'auto'}
      data-responsive="false"
    />
  </div>
</aside>
  )
}

<style>
  .ad-slot {
    width: 100%;
  }
  .ad-slot__label {
    margin: 0 0 var(--space-1);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
  }
  .ad-slot__box {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .ad-slot__unit {
    width: 100%;
  }

  /* Inline (phones/tablets): visible below 75rem only */
  .ad-slot--inline {
    max-width: 336px;
    margin-inline: auto;
  }
  .ad-slot--inline .ad-slot__box {
    min-height: var(--ad-inline-h);
  }

  /* Rail (desktop): visible from 75rem up, in its own column beside the content (it does not float or follow the page) */
  .ad-slot--rail {
    display: none;
  }
  .ad-slot--rail .ad-slot__box {
    min-height: var(--ad-rail-h);
  }

  @media (min-width: 75rem) {
    .ad-slot--inline {
      display: none;
    }
    .ad-slot--rail {
      display: block;
    }
  }
</style>
