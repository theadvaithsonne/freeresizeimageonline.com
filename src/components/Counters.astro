---
/**
 * Live "images resized" and "online now" numbers (real values from the counter Worker, never faked).
 * Renders nothing until COUNTERS.endpoint is set (after the Worker is deployed). The pills stay hidden
 * until the real numbers pass the thresholds in src/config/site.ts, and hide again if the Worker is
 * unreachable - the resizer never depends on it.
 */
import { COUNTERS } from '../config/site';
import { t } from '../i18n';
import { safeJson } from '../i18n/safe-json';

interface Props {
  lang: string;
  /** 'header': inside the header from 75rem; 'bar': a slim bar under the header on phones and tablets. */
  variant: 'header' | 'bar';
}
const { lang, variant } = Astro.props;
const config = {
  endpoint: COUNTERS.endpoint,
  lang,
  minTotal: COUNTERS.minTotalToShow,
  minOnline: COUNTERS.minOnlineToShow,
  resized: t(lang, 'counters.resized'),
  online: t(lang, 'counters.online'),
};
---
{
  COUNTERS.endpoint && (
    <div class:list={['counters', `counters--${variant}`]} data-counters role="group" aria-label={t(lang, 'counters.label')}>
      <span class="pill pill--total" data-counter-total hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M5 17l5-5 4 4 2-2 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span data-counter-total-text><span class="pill__words" data-pre></span><span class="pill__num" data-num></span><span class="pill__words" data-post></span></span>
      </span>
      <span class="pill pill--online" data-counter-online hidden>
        <span class="dot" aria-hidden="true" />
        <span data-counter-online-text><span class="pill__words" data-pre></span><span class="pill__num" data-num></span><span class="pill__words" data-post></span></span>
      </span>
      <script type="application/json" data-counters-config set:html={safeJson(config)} />
    </div>
  )
}

<script>
  import { initCounters } from './counters-client';
  initCounters();
</script>

<style>
  .counters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .counters--header {
    display: none;
  }
  /* Phones and tablets: a slim bar right under the header, so the numbers are seen at once. Its height is reserved
     (no jump when the numbers arrive) and given back if the counter service cannot be reached. */
  .counters--bar {
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.3rem var(--gutter);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .counters--bar {
    gap: 0.4rem;
  }
  .counters--bar .pill {
    padding: 0.25rem 0.6rem;
    font-size: 0.875rem;
    gap: 0.3rem;
  }
  .counters--bar[data-off] {
    display: none;
  }
  /* In the header from laptop width up (it also holds the tabs, the language and the theme buttons): the full wording
     from 90rem, just the numbers with their icons between 75rem and 90rem (the words stay available to screen readers
     and as a tooltip). */
  @media (min-width: 75rem) {
    .counters--header {
      display: flex;
    }
    .counters--bar {
      display: none;
    }
  }
  @media (min-width: 75rem) and (max-width: 89.99rem) {
    .counters--header .pill__words {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .pill__num {
    font-weight: 800;
  }
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 650;
    /* a long translation wraps inside its own pill instead of pushing the page wider */
    max-width: 100%;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--success) 60%, transparent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.45rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>
