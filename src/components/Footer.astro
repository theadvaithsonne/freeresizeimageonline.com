---
import { ADSENSE, SITE } from '../config/site';
import { FAQ_PATH, GUIDES_INDEX_PATH, GUIDE_ROUTES, NAV_GROUPS, routesInGroup } from '../data/routes';
import { list, localizedPath, t, type MessageKey } from '../i18n';
import Counters from './Counters.astro';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();

// Site map columns: every tool page and guide is linked from every page (good for visitors and for search engines).
const columns: { id: string; title: string; links: { href: string; label: string }[] }[] = NAV_GROUPS.map((group) => ({
  id: group,
  title: t(lang, `navGroups.${group}` as MessageKey),
  links: routesInGroup(group).map((r) => ({ href: localizedPath(lang, r.path), label: t(lang, `nav.${r.key}` as MessageKey) })),
}));
const guideTitles = list<{ title: string }>(lang, 'guides.index.items');
columns.push({
  id: 'guides',
  title: t(lang, 'guides.nav'),
  links: [
    { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav') },
    ...GUIDE_ROUTES.map((g, i) => ({ href: localizedPath(lang, g.path), label: guideTitles[i]?.title ?? '' })),
  ],
});

const links = [
  { href: localizedPath(lang, FAQ_PATH), label: t(lang, 'nav.faq') },
  { href: localizedPath(lang, '/about/'), label: t(lang, 'footer.about') },
  { href: localizedPath(lang, '/contact/'), label: t(lang, 'footer.contact') },
  { href: localizedPath(lang, '/privacy/'), label: t(lang, 'footer.privacy') },
  { href: localizedPath(lang, '/terms/'), label: t(lang, 'footer.terms') },
];
---
<footer class="site-footer">
  <div class="container">
    <Counters lang={lang} variant="footer" />
    <div class="site-footer__columns">
      {
        columns.map((c) => (
          <nav class="site-footer__column" aria-labelledby={`footer-${c.id}`}>
            <p class="site-footer__title" id={`footer-${c.id}`}>{c.title}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="site-footer__inner">
      <p class="site-footer__copy">&copy; {year} {SITE.name}</p>
      <nav class="site-footer__nav" aria-label={t(lang, 'footer.label')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        {
          ADSENSE.client && ADSENSE.consentMessage && (
            <button type="button" class="site-footer__cookies" data-cookie-settings>
              {t(lang, 'footer.cookies')}
            </button>
          )
        }
      </nav>
    </div>
  </div>
</footer>

<script>
  // Re-opens Google's consent message (set up inside AdSense > Privacy & messaging) so visitors can change their choice.
  document.querySelectorAll<HTMLElement>('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      const w = window as unknown as { googlefc?: { callbackQueue?: unknown[]; showRevocationMessage?: () => void } };
      if (w.googlefc?.callbackQueue && w.googlefc.showRevocationMessage) {
        w.googlefc.callbackQueue.push(w.googlefc.showRevocationMessage);
      }
    });
  });
</script>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--footer-bg);
    font-size: var(--step-0);
  }
  .site-footer__columns {
    display: grid;
    gap: var(--space-5) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    padding-block: var(--space-6) var(--space-4);
  }
  .site-footer__title {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-strong);
  }
  .site-footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__column a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* touch target of at least 44 px */
    color: var(--text);
    font-weight: 500;
    line-height: 1.3;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border);
  }
  .site-footer__copy {
    margin: 0;
    color: var(--text-muted);
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .site-footer__nav a,
  .site-footer__cookies {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* touch target of at least 44 px */
    color: var(--text);
    font-weight: 600;
    font-size: inherit;
  }
  .site-footer__cookies {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
