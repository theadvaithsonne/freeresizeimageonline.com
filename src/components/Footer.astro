---
import { FAQ_PATH, GUIDES_INDEX_PATH, GUIDE_ROUTES, NAV_GROUPS, routesInGroup } from '../data/routes';
import { list, localizedPath, t, type MessageKey } from '../i18n';

interface Props {
  lang: string;
  /** Show "Cookie settings": only on pages where Google's script is loaded (it re-opens Google's consent message) and once that message exists. */
  cookieLink?: boolean;
}
const { lang, cookieLink = false } = Astro.props;
const year = new Date().getFullYear();

// Site map columns: every tool page and guide is linked from every page (good for visitors and for search engines).
const columns: { id: string; title: string; links: { href: string; label: string }[] }[] = NAV_GROUPS.map((group) => ({
  id: group,
  title: t(lang, `navGroups.${group}` as MessageKey),
  links: routesInGroup(group).map((r) => ({ href: localizedPath(lang, r.path), label: t(lang, `nav.${r.key}` as MessageKey) })),
}));
const guideTitles = list<{ title: string }>(lang, 'guides.index.items');
columns.push({
  id: 'guides',
  title: t(lang, 'guides.nav'),
  links: [
    { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav') },
    ...GUIDE_ROUTES.map((g, i) => ({ href: localizedPath(lang, g.path), label: guideTitles[i]?.title ?? '' })),
  ],
});

const links = [
  { href: localizedPath(lang, FAQ_PATH), label: t(lang, 'nav.faq') },
  { href: localizedPath(lang, '/about/'), label: t(lang, 'footer.about') },
  { href: localizedPath(lang, '/contact/'), label: t(lang, 'footer.contact') },
  { href: localizedPath(lang, '/privacy/'), label: t(lang, 'footer.privacy') },
  { href: localizedPath(lang, '/terms/'), label: t(lang, 'footer.terms') },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__columns">
      {
        columns.map((c) => (
          <nav class="site-footer__column" aria-labelledby={`footer-${c.id}`}>
            <p class="site-footer__title" id={`footer-${c.id}`}>{c.title}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="site-footer__inner">
      <p class="site-footer__copy">&copy; {year} {t(lang, 'brand.name')}</p>
      <nav class="site-footer__nav" aria-label={t(lang, 'footer.label')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        {
          cookieLink && (
            <button type="button" class="site-footer__cookies" data-cookie-settings hidden>
              {t(lang, 'footer.cookies')}
            </button>
          )
        }
      </nav>
    </div>
  </div>
</footer>

<script>
  // "Cookie settings" re-opens Google's consent message (AdSense > Privacy & messaging) so visitors can change their
  // choice. Google only loads that message for visitors in the EEA, UK and Switzerland, so the button stays hidden
  // until Google's code is really there; for everyone else it would do nothing.
  type Fc = { callbackQueue?: unknown[]; showRevocationMessage?: () => void };
  const fc = () => (window as unknown as { googlefc?: Fc }).googlefc;
  const buttons = document.querySelectorAll<HTMLElement>('[data-cookie-settings]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const f = fc();
      if (f?.callbackQueue && f.showRevocationMessage) f.callbackQueue.push(f.showRevocationMessage);
    });
  });
  if (buttons.length > 0) {
    let tries = 0;
    const reveal = () => {
      if (fc()?.showRevocationMessage) buttons.forEach((b) => (b.hidden = false));
      else if (++tries < 40) setTimeout(reveal, 500); // look for up to 20 seconds
    };
    reveal();
  }
</script>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border-strong);
    background: var(--footer-bg);
    font-size: var(--step--1);
  }
  .site-footer__columns {
    display: grid;
    gap: var(--space-5) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    padding-block: var(--space-6) var(--space-3);
  }
  .site-footer__title {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
  }
  .site-footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* the page links: quiet and underlined, like the tool links in TranscribeVid's footer */
  .site-footer__column a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem; /* easy to tap */
    padding-block: 0.3rem;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .site-footer__column a:hover {
    color: var(--text-strong);
    text-decoration-thickness: 2px;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-2) var(--space-4);
    border-top: 1px solid var(--border);
  }
  .site-footer__copy {
    margin: 0;
    color: var(--text);
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }
  /* the main footer links: bold and underlined */
  .site-footer__nav a,
  .site-footer__cookies {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem; /* easy to tap */
    color: var(--text-strong);
    font-weight: 600;
    font-size: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .site-footer__nav a:hover,
  .site-footer__cookies:hover {
    color: var(--text-strong);
    text-decoration-thickness: 3px;
  }
  .site-footer__cookies {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
</style>
