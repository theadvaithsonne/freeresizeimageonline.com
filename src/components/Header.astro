---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Counters from './Counters.astro';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localizedPath(lang, '/')}>
      <Logo />
    </a>
    <div class="site-header__actions">
      <Counters lang={lang} variant="header" />
      <LanguageSwitcher lang={lang} path={path} />
      <ThemeToggle
        label={t(lang, 'a11y.toggleTheme')}
        dark={t(lang, 'a11y.themeDark')}
        light={t(lang, 'a11y.themeLight')}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .site-header__brand {
    text-decoration: none;
    border-radius: var(--radius-sm);
    /* The brand name is a Latin logo even on RTL pages */
    direction: ltr;
    /* shrink (with an ellipsis) instead of pushing the buttons off a narrow screen */
    flex: 0 1 auto;
    min-width: 0;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }
  @media (min-width: 30rem) {
    .site-header__actions {
      gap: var(--space-3);
    }
  }
</style>
