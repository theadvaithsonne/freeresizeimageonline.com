---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Counters from './Counters.astro';
import MobileMenu from './MobileMenu.astro';
import { FAQ_PATH, GUIDES_INDEX_PATH } from '../data/routes';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
// Tabs on the right of the header (wide screens; on phones the same links are at the top of the menu).
const tabs = [
  { href: localizedPath(lang, '/'), label: t(lang, 'nav.homePage'), current: path === '/' },
  { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav'), current: path.startsWith(GUIDES_INDEX_PATH) },
  { href: localizedPath(lang, FAQ_PATH), label: t(lang, 'nav.faq'), current: path === FAQ_PATH },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localizedPath(lang, '/')}>
      <Logo lang={lang} />
    </a>
    <div class="site-header__actions">
      <div class="site-header__tabs">
        {tabs.map((tab) => <a href={tab.href} aria-current={tab.current ? 'page' : undefined}>{tab.label}</a>)}
      </div>
      <Counters lang={lang} variant="header" />
      <LanguageSwitcher lang={lang} path={path} />
      <ThemeToggle
        label={t(lang, 'a11y.toggleTheme')}
        dark={t(lang, 'a11y.themeDark')}
        light={t(lang, 'a11y.themeLight')}
      />
      <MobileMenu lang={lang} path={path} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--surface);
    border-bottom: 1px solid var(--border-strong);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .site-header__brand {
    text-decoration: none;
    border-radius: var(--radius-md);
    /* The brand name is a Latin logo even on RTL pages */
    direction: ltr;
    /* shrink (with an ellipsis) instead of pushing the buttons off a narrow screen */
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  @media (min-width: 30rem) {
    .site-header__actions {
      gap: 10px;
    }
  }
  .site-header__tabs {
    display: none;
  }
  /* Tabs: the open one is a filled box with a 3px orange bar under it (clear without colour: bold text too). */
  @media (min-width: 60rem) {
    .site-header__tabs {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-inline-end: 6px;
    }
    .site-header__tabs a {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      padding: 8px 16px 5px;
      border-bottom: 3px solid transparent;
      border-radius: 8px 8px 0 0;
      color: var(--text);
      font-size: 18px;
      font-weight: 600;
      line-height: 1.2;
      text-decoration: none;
      white-space: nowrap;
    }
    .site-header__tabs a:hover {
      background: var(--surface-2);
      color: var(--text-strong);
    }
    .site-header__tabs a[aria-current='page'] {
      background: var(--surface-3);
      border-bottom-color: var(--brand);
      color: var(--text-strong);
      font-weight: 800;
    }
  }
  @media (min-width: 60rem) and (max-width: 80rem) {
    .site-header__tabs a {
      padding-inline: 12px;
    }
  }
  @media (min-width: 60rem) and (max-width: 67.5rem) {
    .site-header__tabs {
      gap: 2px;
    }
    .site-header__tabs a {
      padding-inline: 9px;
    }
  }
  /* the smallest phones: the whole name still has to fit beside the two buttons */
  @media (max-width: 22.5rem) {
    .site-header__inner {
      gap: 6px;
    }
  }
</style>
