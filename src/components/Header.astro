---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Counters from './Counters.astro';
import MobileMenu from './MobileMenu.astro';
import { FAQ_PATH, GUIDES_INDEX_PATH } from '../data/routes';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
// Tabs on the right of the header (wide screens; on phones the same links are at the top of the menu).
const tabs = [
  { href: localizedPath(lang, '/'), label: t(lang, 'nav.homePage'), current: path === '/' },
  { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav'), current: path.startsWith(GUIDES_INDEX_PATH) },
  { href: localizedPath(lang, FAQ_PATH), label: t(lang, 'nav.faq'), current: path === FAQ_PATH },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localizedPath(lang, '/')}>
      <Logo lang={lang} />
    </a>
    <div class="site-header__actions">
      <div class="site-header__tabs">
        {tabs.map((tab) => <a href={tab.href} aria-current={tab.current ? 'page' : undefined}>{tab.label}</a>)}
      </div>
      <Counters lang={lang} variant="header" />
      <LanguageSwitcher lang={lang} path={path} />
      <ThemeToggle
        label={t(lang, 'a11y.toggleTheme')}
        dark={t(lang, 'a11y.themeDark')}
        light={t(lang, 'a11y.themeLight')}
      />
      <MobileMenu lang={lang} path={path} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .site-header__brand {
    text-decoration: none;
    border-radius: var(--radius-sm);
    /* The brand name is a Latin logo even on RTL pages */
    direction: ltr;
    /* shrink (with an ellipsis) instead of pushing the buttons off a narrow screen */
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }
  @media (min-width: 30rem) {
    .site-header__actions {
      gap: var(--space-3);
    }
  }
  .site-header__tabs {
    display: none;
  }
  @media (min-width: 60rem) {
    .site-header__tabs {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-inline-end: var(--space-3);
    }
    .site-header__tabs a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 var(--space-4);
      border-radius: var(--radius-full);
      color: var(--text);
      font-weight: 650;
      text-decoration: none;
    }
    .site-header__tabs a:hover {
      background: var(--surface-2);
      color: var(--text);
    }
    .site-header__tabs a[aria-current='page'] {
      background: var(--brand-soft);
      color: var(--brand-strong);
    }
  }
</style>
