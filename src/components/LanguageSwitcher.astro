---
import { alternates, getLanguage, t } from '../i18n';

interface Props {
  /** Current language code. */
  lang: string;
  /** Path of the current page without a language prefix, e.g. "/" or "/resize-image-to-50kb/". */
  path: string;
}
const { lang, path } = Astro.props;
const current = getLanguage(lang);
const items = alternates(path);
---
<details class="lang-switch" data-lang-switch>
  <summary class="lang-switch__button" aria-label={`${current.nativeName} - ${t(lang, 'a11y.openLanguages')}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
    <span class="lang-switch__current" lang={current.htmlLang}>{current.nativeName}</span>
    <svg class="lang-switch__chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <nav class="lang-switch__menu" aria-label={t(lang, 'language.label')}>
    <ul>
      {
        items.map(({ language, href }) => (
          <li>
            <a
              href={href}
              lang={language.htmlLang}
              hreflang={language.htmlLang}
              data-lang-code={language.code}
              aria-current={language.code === lang ? 'true' : undefined}
              class:list={{ 'is-current': language.code === lang }}
            >
              {language.nativeName}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>

<script>
  const root = document.querySelector<HTMLDetailsElement>('[data-lang-switch]');
  if (root) {
    // Remember the visitor's explicit choice (used by the "view in your language" suggestion).
    root.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lang-code]');
      if (!link) return;
      try {
        localStorage.setItem('lang-pref', link.dataset.langCode ?? '');
      } catch {
        /* storage unavailable: choice just isn't remembered */
      }
    });
    // Close on outside click / Escape.
    document.addEventListener('click', (event) => {
      if (root.open && !root.contains(event.target as Node)) root.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.open) {
        root.open = false;
        root.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .lang-switch {
    position: relative;
  }
  .lang-switch__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: var(--control-h-sm);
    padding-inline: 16px 14px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: var(--step--1);
    user-select: none;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }
  .lang-switch__button::-webkit-details-marker {
    display: none;
  }
  .lang-switch__button:hover,
  .lang-switch[open] .lang-switch__button {
    border-color: var(--text-strong);
    background: var(--surface-2);
  }
  .lang-switch__current {
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lang-switch__chevron {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .lang-switch[open] .lang-switch__chevron {
    transform: rotate(180deg);
  }

  .lang-switch__menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 12px);
    z-index: 60;
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(70vh, 30rem);
    overflow-y: auto;
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .lang-switch__menu ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lang-switch__menu a {
    display: block;
    padding: 0.75rem var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    font-size: var(--step-0);
    line-height: 1.3;
  }
  .lang-switch__menu a:hover {
    background: var(--surface-2);
    color: var(--text-strong);
  }
  .lang-switch__menu a.is-current {
    background: var(--surface-3);
    color: var(--text-strong);
    font-weight: 800;
  }

  /* Phones: icon-only button to save header space, and the menu spans the screen under the header
     (so it can never stick out of a narrow screen, left-to-right or right-to-left) */
  @media (max-width: 40rem) {
    .lang-switch {
      position: static;
    }
    .lang-switch__current,
    .lang-switch__chevron {
      display: none;
    }
    .lang-switch__button {
      width: var(--control-h-sm);
      padding: 0;
      justify-content: center;
    }
  }
  /* the smallest phones: slightly smaller buttons so the whole name fits beside them */
  @media (max-width: 22.5rem) {
    .lang-switch__button {
      width: 44px;
      height: 44px;
    }
    .lang-switch__menu {
      position: fixed;
      inset-inline: var(--gutter);
      top: calc(var(--header-h) + var(--space-2));
      width: auto;
      max-height: calc(100dvh - var(--header-h) - var(--space-5));
    }
  }
</style>
