---
import { getLanguage, t } from '../i18n';

interface Props {
  /** Show the wordmark next to the icon. */
  wordmark?: boolean;
  class?: string;
  /** Page language: languages that do not use the Latin alphabet show the site name in their own script. */
  lang?: string;
}
const { wordmark = true, class: className, lang = 'en' } = Astro.props;
const logo = t(lang, 'brand.logo');
const name = t(lang, 'brand.name');
const isLatin = logo === 'FreeResizeImage';
---
<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="15" fill="#c2410c" />
    <rect x="13" y="26" width="25" height="25" rx="5" fill="none" stroke="#fff" stroke-width="4.5" />
    <path d="M32 32 L50 14" stroke="#fff" stroke-width="4.5" stroke-linecap="round" />
    <path d="M36 14 H50 V28" fill="none" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {wordmark && isLatin && (
    <span class="logo__text" dir="ltr">Free<strong>Resize</strong>Image<span class="visually-hidden">Online</span></span>
  )}
  {wordmark && !isLatin && (
    <span class="logo__text logo__text--local" lang={getLanguage(lang).htmlLang}>
      <span aria-hidden="true">{logo}</span><span class="visually-hidden">{name}</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
    color: var(--text-strong);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .logo__mark {
    flex: none;
    width: 40px;
    height: 40px;
  }
  .logo__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .logo__text--local {
    font-weight: 750;
    letter-spacing: 0;
  }
  .logo__text strong {
    font-weight: 800;
    color: var(--brand);
  }
  @media (max-width: 67.5rem) {
    .logo {
      font-size: 24px;
    }
  }
  @media (max-width: 25rem) {
    .logo {
      font-size: 23px;
      gap: 10px;
    }
  }
  @media (max-width: 22.5rem) {
    .logo {
      font-size: 18px;
      gap: 7px;
    }
    .logo__mark {
      width: 32px;
      height: 32px;
    }
  }
</style>
