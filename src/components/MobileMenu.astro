---
/**
 * Menu button (burger) and the panel it opens, for phones and tablets (below 60rem). On wide screens the strip of
 * tool links under the header does this job. The panel lists every tool page by group, the guides and the legal
 * pages, so every page is one tap away - and every page is linked from every other page for search engines.
 */
import { FAQ_PATH, GUIDES_INDEX_PATH, GUIDE_ROUTES, LEGAL_ROUTES, NAV_GROUPS, routesInGroup } from '../data/routes';
import { list, localizedPath, t, type MessageKey } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: string;
  /** Current page path without a language prefix. */
  path: string;
}
const { lang, path } = Astro.props;

const groups = NAV_GROUPS.map((group) => ({
  id: group,
  title: t(lang, `navGroups.${group}` as MessageKey),
  links: routesInGroup(group).map((r) => ({
    href: localizedPath(lang, r.path),
    label: t(lang, `nav.${r.key}` as MessageKey),
    current: r.path === path,
  })),
}));

const guideTitles = list<{ title: string }>(lang, 'guides.index.items');
const guideLinks = [
  { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav'), current: path === GUIDES_INDEX_PATH },
  ...GUIDE_ROUTES.map((g, i) => ({
    href: localizedPath(lang, g.path),
    label: guideTitles[i]?.title ?? '',
    current: path === g.path,
  })),
];
const legalLinks = LEGAL_ROUTES.map((r) => ({
  href: localizedPath(lang, r.path),
  label: t(lang, `footer.${r.key}` as MessageKey),
  current: r.path === path,
}));
const quick = [
  { href: localizedPath(lang, '/'), label: t(lang, 'nav.homePage'), current: path === '/' },
  { href: localizedPath(lang, GUIDES_INDEX_PATH), label: t(lang, 'guides.nav'), current: path.startsWith(GUIDES_INDEX_PATH) },
  { href: localizedPath(lang, FAQ_PATH), label: t(lang, 'nav.faq'), current: path === FAQ_PATH },
];
const label = t(lang, 'a11y.menu');
---
<button
  type="button"
  class="menu-button"
  data-menu-button
  aria-expanded="false"
  aria-controls="site-menu"
  aria-label={label}
>
  <svg class="menu-button__open" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  </svg>
  <svg class="menu-button__close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  </svg>
</button>

<nav class="menu-panel" id="site-menu" data-menu-panel aria-label={label} hidden>
  <div class="container menu-panel__inner">
    <ul class="menu-quick">
      {
        quick.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    {
      groups.map((g) => (
        <section class="menu-group">
          <p class="menu-group__title" id={`menu-${g.id}`}>{g.title}</p>
          <ul aria-labelledby={`menu-${g.id}`}>
            {g.links.map((l) => (
              <li>
                <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <section class="menu-group">
      <p class="menu-group__title" id="menu-guides">{t(lang, 'guides.nav')}</p>
      <ul aria-labelledby="menu-guides">
        {
          guideLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
    <div class="menu-theme">
      <ThemeToggle
        variant="menu"
        label={t(lang, 'a11y.toggleTheme')}
        dark={t(lang, 'a11y.themeDark')}
        light={t(lang, 'a11y.themeLight')}
      />
    </div>
    <ul class="menu-legal">
      {
        legalLinks.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  if (button && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
    // Close on outside click (this also closes it when the language menu is opened) and on Escape.
    document.addEventListener('click', (event) => {
      if (!panel.hidden && !panel.contains(event.target as Node) && !button.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    // Opening the language list or switching to a wide screen closes the menu.
    document.querySelector('[data-lang-switch]')?.addEventListener('toggle', (event) => {
      if ((event.target as HTMLDetailsElement).open) setOpen(false);
    });
    window.matchMedia('(min-width: 60rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }
  .menu-button:hover {
    border-color: var(--text-strong);
    background: var(--surface-2);
  }
  .menu-button[aria-expanded='true'] {
    border-color: var(--text-strong);
    background: var(--surface-3);
  }
  .menu-button__close,
  .menu-button[aria-expanded='true'] .menu-button__open {
    display: none;
  }
  .menu-button[aria-expanded='true'] .menu-button__close {
    display: block;
  }

  /* The panel hangs under the header (the header is its positioning context) and scrolls on its own if it is tall. */
  .menu-panel {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border-bottom: 2px solid var(--border-strong);
  }
  .menu-panel[hidden] {
    display: none;
  }
  .menu-panel__inner {
    display: grid;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-4) var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }
  .menu-group ul,
  .menu-legal {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-group__title {
    margin: 0 0 var(--space-1);
    padding-inline: var(--space-3);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
  }
  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.3rem var(--space-3);
    border-inline-start: 4px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.3;
    text-decoration: none;
  }
  .menu-panel a:hover {
    background: var(--surface-2);
    color: var(--text-strong);
  }
  .menu-panel a[aria-current='page'] {
    background: var(--surface-3);
    border-inline-start-color: var(--brand);
    color: var(--text-strong);
    font-weight: 800;
  }
  /* The theme switch lives in the menu only on very small phones; elsewhere it is in the header. */
  .menu-theme {
    display: none;
    grid-column: 1 / -1;
  }
  @media (max-width: 29.99rem) {
    .menu-theme {
      display: block;
    }
  }
  /* Home, Guides and FAQ as three prominent tabs at the top of the menu */
  .menu-quick {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .menu-quick li {
    flex: 1 1 6rem;
  }
  .menu-quick a {
    justify-content: center;
    min-height: 3rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-weight: 700;
  }
  .menu-quick a[aria-current='page'] {
    border-color: var(--brand);
    border-inline-start-color: var(--brand);
  }
  .menu-legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .menu-legal a {
    color: var(--text-muted);
    font-weight: 600;
  }

  @media (max-width: 22.5rem) {
    .menu-button {
      width: 44px;
      height: 44px;
    }
  }

  /* On wide screens the strip under the header replaces the menu. */
  @media (min-width: 60rem) {
    .menu-button,
    .menu-panel {
      display: none;
    }
  }
</style>
