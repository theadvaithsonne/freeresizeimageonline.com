---
// Light/dark toggle (pill with icon + word, like the reference design). The initial theme is applied by an
// inline script in Layout.astro (no flash).
interface Props {
  /** Accessible description of what the button does. */
  label: string;
  /** Visible word shown while the light theme is active (the action: switch to dark). */
  dark: string;
  /** Visible word shown while the dark theme is active. */
  light: string;
}
const { label, dark, light } = Astro.props;
---
<!-- The accessible name is "<label>: <visible word>", so it always contains the word that is on screen (WCAG 2.5.3). -->
<button type="button" class="theme-toggle" data-theme-toggle title={label}>
  <span class="visually-hidden">{label}:</span>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  </svg>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="theme-toggle__text theme-toggle__text--dark">{dark}</span>
  <span class="theme-toggle__text theme-toggle__text--light">{light}</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable (private mode): the choice just isn't remembered */
    }
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: var(--control-h);
    height: var(--control-h);
    padding: 0 var(--space-3);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text);
    font-weight: 700;
    font-size: var(--step-0);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--surface-2);
  }
  .icon--sun,
  .theme-toggle__text--light {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon--sun,
  :global(:root[data-theme='dark']) .theme-toggle__text--light {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon--moon,
  :global(:root[data-theme='dark']) .theme-toggle__text--dark {
    display: none;
  }
  /* Phones: icon only, to leave room for the logo (the word stays available to screen readers) */
  @media (max-width: 40rem) {
    .theme-toggle__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .theme-toggle {
      padding: 0;
      width: var(--control-h);
    }
  }
</style>
