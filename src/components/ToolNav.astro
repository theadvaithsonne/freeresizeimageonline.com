---
/**
 * Strip of links to every tool page, under the header. Helps people find the right tool quickly
 * (and search engines find every page). The current page is highlighted.
 */
import { TOOL_ROUTES } from '../data/routes';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
---
<nav class="toolnav" aria-label={t(lang, 'common.related')}>
  <div class="container toolnav__inner">
    {
      TOOL_ROUTES.map((r) => (
        <a
          href={localizedPath(lang, r.path)}
          aria-current={r.path === path ? 'page' : undefined}
          class:list={{ 'is-current': r.path === path }}
        >
          {t(lang, `nav.${r.key}` as 'nav.home')}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .toolnav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .toolnav__inner {
    display: flex;
    gap: var(--space-2);
    padding-block: var(--space-2);
    overflow-x: auto; /* scrolls sideways on phones instead of wrapping into many rows */
    scrollbar-width: thin;
  }
  @media (min-width: 60rem) {
    .toolnav__inner {
      flex-wrap: wrap; /* on wide screens every link is visible */
      overflow-x: visible;
    }
  }
  .toolnav a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 650;
    font-size: var(--step-0);
    text-decoration: none;
    white-space: nowrap;
  }
  .toolnav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .toolnav a.is-current {
    background: var(--brand-soft);
    box-shadow: inset 0 -3px 0 var(--brand);
  }
</style>
