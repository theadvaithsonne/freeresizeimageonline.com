---
/**
 * Strip of links to every tool page, under the header. Helps people find the right tool quickly
 * (and search engines find every page). The current page is highlighted.
 */
import { GUIDES_INDEX_PATH, TOOL_ROUTES } from '../data/routes';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
// The tool links plus one link to the written guides (highlighted on the guides index and on every guide).
const links = [
  ...TOOL_ROUTES.map((r) => ({ href: r.path, label: t(lang, `nav.${r.key}` as 'nav.home'), current: r.path === path })),
  { href: GUIDES_INDEX_PATH, label: t(lang, 'guides.nav'), current: path.startsWith(GUIDES_INDEX_PATH) },
];
---
<nav class="toolnav" aria-label={t(lang, 'common.related')}>
  <div class="container toolnav__inner">
    {
      links.map((l) => (
        <a
          href={localizedPath(lang, l.href)}
          aria-current={l.current ? 'page' : undefined}
          class:list={{ 'is-current': l.current }}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  // On phones the strip scrolls sideways: bring the page you are on into the middle so it is always visible.
  const current = document.querySelector<HTMLElement>('.toolnav a.is-current');
  const strip = current?.parentElement;
  if (current && strip && strip.scrollWidth > strip.clientWidth) {
    // block: 'nearest' keeps the page from scrolling vertically; the browser handles left-to-right and right-to-left
    current.scrollIntoView({ inline: 'center', block: 'nearest' });
  }
</script>

<style>
  .toolnav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .toolnav__inner {
    display: flex;
    gap: var(--space-2);
    padding-block: var(--space-2);
    overflow-x: auto; /* scrolls sideways on phones instead of wrapping into many rows */
    scrollbar-width: thin;
  }
  /* Phones/tablets: faded edges show that the strip scrolls sideways */
  @media (max-width: 59.99rem) {
    .toolnav__inner {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 0.75rem, #000 calc(100% - 2.5rem), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 0.75rem, #000 calc(100% - 2.5rem), transparent 100%);
      scroll-padding-inline: 2rem;
    }
    :global([dir='rtl']) .toolnav__inner {
      -webkit-mask-image: linear-gradient(to left, transparent 0, #000 0.75rem, #000 calc(100% - 2.5rem), transparent 100%);
      mask-image: linear-gradient(to left, transparent 0, #000 0.75rem, #000 calc(100% - 2.5rem), transparent 100%);
    }
  }
  @media (min-width: 60rem) {
    .toolnav__inner {
      flex-wrap: wrap; /* on wide screens every link is visible */
      overflow-x: visible;
    }
  }
  .toolnav a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 650;
    font-size: var(--step-0);
    text-decoration: none;
    white-space: nowrap;
  }
  .toolnav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .toolnav a.is-current {
    background: var(--brand-soft);
    box-shadow: inset 0 -3px 0 var(--brand);
  }
</style>
