---
/**
 * Strip of links to the main tool pages, under the header (wide screens only: phones and tablets use the menu
 * button in the header instead). The current page is highlighted.
 */
import { TOOL_ROUTES } from '../data/routes';
import { localizedPath, t } from '../i18n';

interface Props {
  lang: string;
  /** Current page path without language prefix. */
  path: string;
}
const { lang, path } = Astro.props;
const here = TOOL_ROUTES.find((x) => x.path === path);
const links = TOOL_ROUTES.filter((r) => r.strip).map((r) => ({
  href: r.path,
  label: t(lang, `nav.${r.key}` as 'nav.home'),
  current: r.path === path || here?.parent === r.key,
}));
---
<nav class="toolnav" aria-label={t(lang, 'common.related')}>
  <div class="container toolnav__inner">
    {
      links.map((l) => (
        <a
          href={localizedPath(lang, l.href)}
          aria-current={l.current ? 'page' : undefined}
          class:list={{ 'is-current': l.current }}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .toolnav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .toolnav__inner {
    display: flex;
    gap: var(--space-1);
    padding-block: var(--space-2);
  }
  /* Phones and tablets use the menu button in the header instead of this strip. */
  @media (max-width: 59.99rem) {
    .toolnav {
      display: none;
    }
  }
  @media (min-width: 60rem) {
    .toolnav__inner {
      flex-wrap: wrap; /* on wide screens every link is visible */
    }
  }
  .toolnav a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 600;
    font-size: var(--step-0);
    text-decoration: none;
    white-space: nowrap;
  }
  .toolnav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .toolnav a.is-current {
    background: var(--brand-soft);
    box-shadow: inset 0 -3px 0 var(--brand);
  }
</style>
