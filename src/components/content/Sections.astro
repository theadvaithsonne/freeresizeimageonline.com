---
/**
 * Reusable content blocks for tool pages: numbered steps, tips, FAQ, related links, and a prose wrapper.
 * Each block is optional; pass only what the page has.
 */
import { localizedPath, t } from '../../i18n';
import { TOOL_ROUTES } from '../../data/routes';

interface Step {
  title: string;
  text: string;
}
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  lang: string;
  stepsTitle?: string;
  steps?: Step[];
  tipsTitle?: string;
  tips?: string[];
  faqTitle?: string;
  faq?: FaqItem[];
  /** Key of the current page, hidden from the "more tools" list. */
  currentKey?: string;
  showRelated?: boolean;
}
const { lang, stepsTitle, steps = [], tipsTitle, tips = [], faqTitle, faq = [], currentKey, showRelated = true } = Astro.props;
const related = TOOL_ROUTES.filter((r) => r.key !== currentKey);
---
<div class="content">
  {
    steps.length > 0 && (
      <section class="block" aria-labelledby="how-title">
        <h2 id="how-title">{stepsTitle}</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <slot />

  {
    tips.length > 0 && (
      <section class="block" aria-labelledby="tips-title">
        <h2 id="tips-title">{tipsTitle}</h2>
        <ul class="tips">
          {tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    faq.length > 0 && (
      <section class="block" aria-labelledby="faq-title">
        <h2 id="faq-title">{faqTitle}</h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {
    showRelated && (
      <section class="block" aria-labelledby="related-title">
        <h2 id="related-title">{t(lang, 'common.related')}</h2>
        <ul class="related">
          {related.map((r) => (
            <li>
              <a href={localizedPath(lang, r.path)}>{t(lang, `nav.${r.key}` as 'nav.home')}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .content {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-7);
    max-width: 52rem;
  }
  .block h2 {
    font-size: var(--step-2);
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-4) 3.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: var(--space-4);
    top: var(--space-4);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 800;
  }
  :global([dir='rtl']) .steps li {
    padding: var(--space-4) 3.75rem var(--space-4) var(--space-4);
  }
  .steps h3 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-1);
  }
  .steps p {
    margin: 0;
    color: var(--text-muted);
  }
  .tips {
    margin: 0;
    padding-inline-start: 1.25rem;
    display: grid;
    gap: var(--space-2);
  }
  .faq {
    display: grid;
    gap: var(--space-2);
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0 var(--space-4);
  }
  .faq summary {
    cursor: pointer;
    font-weight: 650;
    padding: var(--space-3) 0;
    min-height: 2.75rem;
  }
  .faq p {
    margin: 0 0 var(--space-4);
    color: var(--text-muted);
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .related a {
    display: inline-block;
    padding: 0.5rem var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .related a:hover {
    background: var(--brand-soft);
    color: var(--brand-strong);
  }
</style>
