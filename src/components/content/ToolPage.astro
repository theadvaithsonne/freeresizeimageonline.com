---
/**
 * Landing page for one tool intent (resize to KB, in cm, passport photos, ...).
 * Content comes from the "pages.<key>" locale entries; the tool is preset for the intent.
 */
import Layout from '../../layouts/Layout.astro';
import ResizerTool from '../tool/ResizerTool.astro';
import Sections from './Sections.astro';
import SizeTable from './SizeTable.astro';
import { SITE } from '../../config/site';
import { list, localizedPath, t, type MessageKey } from '../../i18n';
import { safeJson } from '../../i18n/safe-json';
import { TOOL_ROUTES } from '../../data/routes';

interface Props {
  lang: string;
  pageKey: 'kb' | 'cm' | 'passport' | 'social' | 'convert' | 'compress';
  preset?: string;
  format?: 'original' | 'jpeg' | 'png' | 'webp';
  unit?: 'px' | 'cm' | 'mm' | 'in';
  dpi?: number;
  mode?: 'dimensions' | 'percent' | 'keep';
  table?: 'documents' | 'social';
}
const { lang, pageKey, preset, format, unit, dpi, mode, table } = Astro.props;
const route = TOOL_ROUTES.find((r) => r.key === pageKey)!;
const p = (suffix: string) => t(lang, `${pageKey}.${suffix}` as MessageKey);

const steps = list<{ title: string; text: string }>(lang, `${pageKey}.steps`);
const tips = list<string>(lang, `${pageKey}.tips`);
const faq = list<{ q: string; a: string }>(lang, `${pageKey}.faq.items`);
const hasNote = pageKey === 'passport' || pageKey === 'social';
const pageUrl = new URL(localizedPath(lang, route.path), SITE.url).href;

const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav.home'), item: new URL(localizedPath(lang, '/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: t(lang, `nav.${pageKey}` as 'nav.home'), item: pageUrl },
  ],
};
---
<Layout title={p('title')} description={p('description')} lang={lang} path={route.path} inlineAd="manual">
  <Fragment slot="head">
    {faqLd && <script type="application/ld+json" set:html={safeJson(faqLd)} />}
    <script type="application/ld+json" set:html={safeJson(breadcrumbLd)} />
  </Fragment>

  <h1>{p('h1')}</h1>
  <p class="lead">{p('intro')}</p>

  <ResizerTool lang={lang} preset={preset} format={format} unit={unit} dpi={dpi} mode={mode} />

  <Sections
    lang={lang}
    stepsTitle={t(lang, 'common.howTo')}
    steps={steps}
    tipsTitle={p('tipsTitle')}
    tips={tips}
    faqTitle={t(lang, 'common.faqTitle')}
    faq={faq}
    currentKey={pageKey}
    inlineAd
  >
    {
      table && (
        <section class="block">
          <h2>{p('tableTitle')}</h2>
          <SizeTable lang={lang} kind={table} />
          {hasNote && (
            <p class="note">
              <strong>{t(lang, 'common.goodToKnow')}:</strong> {p('note')}
            </p>
          )}
        </section>
      )
    }
  </Sections>
</Layout>

<style>
  .lead {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 52rem;
  }
  .block h2 {
    font-size: var(--step-2);
  }
  .note {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--brand-soft);
    border-radius: var(--radius-md);
  }
</style>
