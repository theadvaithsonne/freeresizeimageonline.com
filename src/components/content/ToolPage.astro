---
/**
 * Landing page for one tool intent (resize to KB, in cm, passport photos, ...).
 * Content comes from the "pages.<key>" locale entries; the tool is preset for the intent.
 */
import Layout from '../../layouts/Layout.astro';
import ResizerTool from '../tool/ResizerTool.astro';
import PdfTool from '../tool/PdfTool.astro';
import CalcTool from '../tool/CalcTool.astro';
import Sections from './Sections.astro';
import SizeTable from './SizeTable.astro';
import PaperTable from './PaperTable.astro';
import { SITE } from '../../config/site';
import { getLanguage, list, localizedPath, t, type MessageKey } from '../../i18n';
import { safeJson } from '../../i18n/safe-json';
import { TOOL_ROUTES, type ToolKey } from '../../data/routes';

interface Props {
  lang: string;
  pageKey: Exclude<ToolKey, 'home'>;
  preset?: string;
  format?: 'original' | 'jpeg' | 'png' | 'webp';
  unit?: 'px' | 'cm' | 'mm' | 'in';
  dpi?: number;
  mode?: 'dimensions' | 'percent' | 'keep';
  table?: 'documents' | 'social' | 'paper';
  /** For a platform page: only the presets of these names appear in the size table (['Instagram']). */
  tableOnly?: string[];
  /** Which widget the page shows: the resizer (default), the images-to-PDF maker or the size converter. */
  tool?: 'resizer' | 'pdf' | 'calc';
  /** Size converter only: the unit the page starts from and the one it converts to. */
  calcFrom?: 'px' | 'cm' | 'mm' | 'in';
  calcTo?: 'px' | 'cm' | 'mm' | 'in';
}
const { lang, pageKey, preset, format, unit, dpi, mode, table, tableOnly, tool = 'resizer', calcFrom = 'cm', calcTo = 'px' } = Astro.props;
const route = TOOL_ROUTES.find((r) => r.key === pageKey)!;
const p = (suffix: string) => t(lang, `${pageKey}.${suffix}` as MessageKey);

const steps = list<{ title: string; text: string }>(lang, `${pageKey}.steps`);
const tips = list<string>(lang, `${pageKey}.tips`);
// A short explanatory section ("Why 50 KB works well", "Which format should you pick?"): real text for readers and search engines.
const details = list<string>(lang, `${pageKey}.details`);
const faq = list<{ q: string; a: string }>(lang, `${pageKey}.faq.items`);
const hasNote = table !== undefined; // every page with a table has a note under it
const pageUrl = new URL(localizedPath(lang, route.path), SITE.url).href;

const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: p('h1'),
  url: pageUrl,
  description: p('description'),
  applicationCategory: tool === 'calc' ? 'UtilitiesApplication' : 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern web browser',
  inLanguage: getLanguage(lang).htmlLang,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav.home'), item: new URL(localizedPath(lang, '/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: t(lang, `nav.${pageKey}` as 'nav.home'), item: pageUrl },
  ],
};
---
<Layout title={p('title')} description={p('description')} lang={lang} path={route.path} inlineAd="manual">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJson(appLd)} />
    {faqLd && <script type="application/ld+json" set:html={safeJson(faqLd)} />}
    <script type="application/ld+json" set:html={safeJson(breadcrumbLd)} />
  </Fragment>

  <h1>{p('h1')}</h1>
  <p class="lead">{p('intro')}</p>

  {tool === 'pdf' && <PdfTool lang={lang} />}
  {tool === 'calc' && <CalcTool lang={lang} from={calcFrom} to={calcTo} dpi={dpi} />}
  {tool === 'resizer' && <ResizerTool lang={lang} preset={preset} format={format} unit={unit} dpi={dpi} mode={mode} />}

  <Sections
    lang={lang}
    stepsTitle={t(lang, 'common.howTo')}
    steps={steps}
    tipsTitle={p('tipsTitle')}
    tips={tips}
    detailsTitle={p('detailsTitle')}
    details={details}
    faqTitle={t(lang, 'common.faqTitle')}
    faq={faq}
    currentKey={pageKey}
    inlineAd
  >
    {
      table && (
        <section class="block">
          <h2>{p('tableTitle')}</h2>
          {table === 'paper' ? <PaperTable lang={lang} /> : <SizeTable lang={lang} kind={table} only={tableOnly} />}
          {hasNote && (
            <p class="note">
              <strong>{t(lang, 'common.goodToKnow')}:</strong> {p('note')}
            </p>
          )}
        </section>
      )
    }
  </Sections>
</Layout>

<style>
  .lead {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 52rem;
  }
  .block h2 {
    font-size: var(--step-2);
  }
  .note {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--brand-soft);
    border-radius: var(--radius-md);
  }
</style>
