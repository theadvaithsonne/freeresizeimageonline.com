---
/**
 * "Images to PDF": add pictures, put them in order, choose the page, get one PDF. Runs in the browser (pdf-client.ts, src/engine/pdf.ts).
 * Texts come from tool.pdf.* (and the drop zone texts of the resizer, tool.drop.*), in the page language.
 */
import { subtree, t } from '../../i18n';
import { safeJson } from '../../i18n/safe-json';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const clientData = { lang, text: subtree(lang, 'tool') };
const choices = (keys: string[], base: string) => keys.map((k) => ({ value: k, label: t(lang, `${base}.${k}` as 'tool.pdf.options.a4') }));
const sizes = choices(['a4', 'letter', 'fit'], 'tool.pdf.options');
const orientations = [
  { value: 'auto', label: t(lang, 'tool.pdf.options.auto') },
  { value: 'portrait', label: t(lang, 'tool.pdf.options.portrait') },
  { value: 'landscape', label: t(lang, 'tool.pdf.options.landscape') },
];
const margins = [
  { value: 'none', label: t(lang, 'tool.pdf.options.none') },
  { value: 'small', label: t(lang, 'tool.pdf.options.small') },
  { value: 'big', label: t(lang, 'tool.pdf.options.big') },
];
const qualities = [
  { value: 'high', label: t(lang, 'tool.pdf.options.high') },
  { value: 'balanced', label: t(lang, 'tool.pdf.options.balanced') },
  { value: 'low', label: t(lang, 'tool.pdf.options.low') },
];
---
<section class="pdf" data-pdf data-view="setup" aria-label={t(lang, 'tool.pdf.aria')}>
  <div class="pdf__grid" data-setup>
    <div class="pdf__main">
      <div class="drop" data-drop>
        <svg class="drop__icon" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" focusable="false">
          <path d="M12 5h17l9 9v29H12z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          <path d="M29 5v9h9" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          <circle cx="20" cy="26" r="2.6" fill="currentColor" />
          <path d="M14 38l8-7 5 4 4-3 5 5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="drop__title">{t(lang, 'tool.drop.title')}</p>
        <p class="drop__or">{t(lang, 'tool.drop.or')}</p>
        <button type="button" class="btn drop__button" data-choose>{t(lang, 'tool.drop.choose')}</button>
        <input type="file" accept="image/*" multiple hidden data-file-input />
        <p class="drop__hint">{t(lang, 'tool.drop.paste')}</p>
        <p class="drop__hint">{t(lang, 'tool.pdf.hint')}</p>
        <p class="drop__privacy">{t(lang, 'tool.drop.privacy')}</p>
      </div>
      <p class="notice" role="alert" data-notice hidden></p>
      <noscript><p class="notice">{t(lang, 'tool.noscript')}</p></noscript>

      <div class="files" data-files hidden>
        <div class="files__head">
          <h2 class="files__title" data-files-title></h2>
          <button type="button" class="link-button" data-clear>{t(lang, 'tool.files.clear')}</button>
        </div>
        <ol class="files__list" data-list></ol>
      </div>
    </div>

    <form class="options card" data-options novalidate>
      <h2 class="options__title">{t(lang, 'tool.pdf.options.title')}</h2>
      <div class="field">
        <label for="pdf-size">{t(lang, 'tool.pdf.options.pageSize')}</label>
        <select id="pdf-size" data-page-size>{sizes.map((o) => <option value={o.value}>{o.label}</option>)}</select>
      </div>
      <div class="field">
        <label for="pdf-orientation">{t(lang, 'tool.pdf.options.orientation')}</label>
        <select id="pdf-orientation" data-orientation>{orientations.map((o) => <option value={o.value}>{o.label}</option>)}</select>
      </div>
      <div class="field">
        <label for="pdf-margin">{t(lang, 'tool.pdf.options.margin')}</label>
        <select id="pdf-margin" data-margin>{margins.map((o) => <option value={o.value}>{o.label}</option>)}</select>
      </div>
      <div class="field">
        <label for="pdf-quality">{t(lang, 'tool.pdf.options.quality')}</label>
        <select id="pdf-quality" data-quality>{qualities.map((o) => <option value={o.value}>{o.label}</option>)}</select>
        <p class="field__note">{t(lang, 'tool.pdf.options.qualityNote')}</p>
      </div>
      <p class="field__error" role="alert" data-error hidden></p>
      <div class="actions">
        <button type="submit" class="btn btn--big" data-create disabled>{t(lang, 'tool.pdf.actions.create')}</button>
      </div>
    </form>
  </div>

  <div class="result card" data-result hidden>
    <h2 class="result__title" data-result-title tabindex="-1">{t(lang, 'tool.pdf.result.title')}</h2>
    <p class="result__info" data-result-info></p>
    <div class="result__actions">
      <button type="button" class="btn btn--big" data-download>{t(lang, 'tool.pdf.actions.download')}</button>
      <button type="button" class="btn btn--ghost" data-back>{t(lang, 'tool.results.back')}</button>
      <button type="button" class="btn btn--ghost" data-again>{t(lang, 'tool.pdf.actions.again')}</button>
    </div>
    <div class="result__pages" data-pages-box hidden>
      <h3 class="result__pages-title" data-pages-title></h3>
      <ol class="pages" data-pages></ol>
    </div>
  </div>

  <div class="visually-hidden" aria-live="polite" data-live></div>

  <div class="drop-overlay" data-drop-overlay hidden aria-hidden="true">
    <div class="drop-overlay__box">{t(lang, 'tool.drop.title')}</div>
  </div>

  <template data-row-template>
    <li class="item" data-row>
      <span class="item__no" data-page-no aria-hidden="true"></span>
      <div class="item__thumb"><img alt="" width="72" height="72" decoding="async" /></div>
      <div class="item__info">
        <p class="item__name" data-name></p>
        <p class="item__meta" data-meta></p>
      </div>
      <div class="item__buttons">
        <button type="button" class="icon-button" data-up>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
        </button>
        <button type="button" class="icon-button" data-down>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
        </button>
        <button type="button" class="icon-button" data-remove>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" /></svg>
        </button>
      </div>
    </li>
  </template>

  <template data-page-template>
    <li class="pg">
      <figure class="pg__fig">
        <div class="pg__sheet"><img alt="" decoding="async" /></div>
        <figcaption class="pg__cap" data-caption></figcaption>
      </figure>
    </li>
  </template>

  <script type="application/json" data-pdf-data set:html={safeJson(clientData)} />
</section>

<script>
  import { initPdf } from './pdf-client';
  document.querySelectorAll<HTMLElement>('[data-pdf]').forEach((root) => initPdf(root));
</script>

<style>
  .pdf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .pdf__main,
  .options {
    min-width: 0;
  }
  @container page (min-width: 40rem) {
    .pdf__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 1fr);
    }
  }

  /* Drop zone (the same look as the resizer's) */
  .drop {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 14px;
    min-height: 20rem;
    padding: clamp(18px, 2.6vh, 28px) var(--space-4);
    text-align: center;
    background: var(--surface);
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.18s var(--ease),
      background-color 0.18s var(--ease);
  }
  .drop:hover,
  .drop.is-over {
    border-color: var(--brand-bright);
    background: var(--surface-2);
  }
  .drop__icon {
    width: 32px;
    height: 32px;
    color: var(--text-strong);
    padding: 16px;
    box-sizing: content-box;
    background: var(--surface-2);
    border-radius: var(--radius-lg);
  }
  .drop__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--text-strong);
    line-height: 1.25;
  }
  .drop__or,
  .drop__hint {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .drop__hint {
    max-width: 44ch;
  }
  .drop__button {
    min-height: 60px;
    min-width: min(240px, 100%);
    padding: 12px clamp(var(--space-4), 7vw, 36px);
    max-width: 100%;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
  }
  .drop__privacy {
    margin: 0;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .has-files .drop {
    min-height: 0;
    padding-block: var(--space-5);
  }
  .has-files .drop__icon,
  .has-files .drop__hint,
  .has-files .drop__or {
    display: none;
  }
  .notice {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--danger-soft);
    border-radius: var(--radius-md);
    color: var(--text);
    font-weight: 600;
  }

  /* The list of pictures = the pages, in order */
  .files {
    margin-top: var(--space-5);
  }
  .files__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .files__title {
    font-size: var(--step-2);
    margin: 0;
  }
  .link-button {
    background: none;
    border: 0;
    padding: var(--space-3);
    color: var(--accent);
    font-weight: 700;
    font-size: var(--step-0);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .files__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .item {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .item__no {
    min-width: 1.6rem;
    text-align: center;
    font-weight: 800;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .item__thumb {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    overflow: hidden;
  }
  .item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .item__name {
    margin: 0;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: start;
  }
  .item__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .item__buttons {
    display: flex;
    gap: 2px;
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .icon-button:hover:not(:disabled) {
    background: var(--surface-2);
    color: var(--text-strong);
  }
  .icon-button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 30rem) {
    .item {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .item__thumb {
      display: none;
    }
    .item__buttons {
      grid-column: 1 / -1;
      justify-content: flex-end;
    }
  }

  /* Settings card */
  .options {
    padding: clamp(18px, 2.6vh, 28px);
    display: grid;
    gap: 18px;
    border-radius: var(--radius-lg);
  }
  .options__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 800;
  }
  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .field label {
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--text-strong);
  }
  .field__note {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
  }
  .field__error {
    margin: 0;
    padding: 12px 16px;
    background: var(--danger-soft);
    border: 2px solid var(--danger);
    border-radius: var(--radius-lg);
    font-weight: 650;
  }
  .options :global(select) {
    width: 100%;
    min-height: 50px;
    padding: 8px 15px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font: inherit;
    font-size: var(--step-0);
  }
  .options :global(select):hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border-strong));
  }
  .options :global(select):focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--ring);
  }
  @supports not (appearance: base-select) {
    .options :global(select) {
      appearance: auto;
    }
  }
  .actions {
    display: grid;
    padding-top: 2px;
  }
  .btn--big {
    min-height: 58px;
    font-size: var(--step-1);
    font-weight: 700;
  }
  .actions .btn:disabled {
    cursor: not-allowed;
    background: var(--surface-2);
    border-color: var(--border-strong);
    color: var(--text-muted);
  }
  .is-busy .actions .btn {
    cursor: progress;
  }

  /* Result */
  .result {
    padding: clamp(20px, 3vh, 32px);
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .result__title {
    margin: 0;
    font-size: var(--step-3);
  }
  .result__title:focus {
    outline: none;
  }
  .result__info {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 650;
    color: var(--text-muted);
  }
  .result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* The finished pages, drawn the way they are in the PDF (page size, margin, direction) */
  .result__pages {
    width: 100%;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .result__pages-title {
    margin: 0 0 var(--space-4);
    font-size: var(--step-1);
  }
  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--space-5) var(--space-4);
    align-items: start;
  }
  .pg__fig {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .pg__sheet {
    width: 100%;
    background: #ffffff; /* a PDF page is white, also in the dark theme */
    border: 1px solid var(--border-strong);
    border-radius: 2px;
    overflow: hidden;
  }
  .pg__sheet img {
    display: block;
    width: 100%;
    height: auto;
  }
  .pg__cap {
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* drop files anywhere: the whole window says so */
  .drop-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 24px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    pointer-events: none;
  }
  .drop-overlay__box {
    width: min(560px, 100%);
    padding: 48px 24px;
    border: 3px dashed var(--brand-bright);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text-strong);
    font-size: var(--step-1);
    font-weight: 800;
    text-align: center;
  }
</style>
