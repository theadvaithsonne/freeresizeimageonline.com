---
import { PRESET_GROUPS, presetLabel } from '../../data/presets';
import { subtree } from '../../i18n';
import { t } from '../../i18n';

interface Props {
  lang: string;
  /** Preset id to apply on load (used by landing pages such as "resize to 50 KB"). */
  preset?: string;
  /** Format to preselect on load. */
  format?: 'original' | 'jpeg' | 'png' | 'webp';
  /** Unit (and DPI) to preselect, e.g. cm at 300 DPI on the "resize in cm" page. */
  unit?: 'px' | 'cm' | 'mm' | 'in';
  dpi?: number;
  /** Resize mode to preselect (convert/compress pages start on "keep size"). */
  mode?: 'dimensions' | 'percent' | 'keep';
}
const { lang, preset, format = 'original', unit, dpi, mode } = Astro.props;

const words = subtree(lang, 'tool.presets.words') as Record<string, string>;
const groups = PRESET_GROUPS.map((g) => ({
  id: g.id,
  title: t(lang, `tool.presets.groups.${g.id}` as 'tool.presets.groups.social'),
  presets: g.presets.map((p) => ({ preset: p, label: presetLabel(p, words) })),
}));

// Everything the client script needs, in the visitor's language.
const clientData = {
  lang,
  initialPreset: preset ?? '',
  initialFormat: format,
  initialMode: mode ?? '',
  initialUnit: unit ?? '',
  initialDpi: dpi ?? 0,
  text: subtree(lang, 'tool'),
};
---
<section class="tool" data-tool aria-label={t(lang, 'tool.aria')}>
  <div class="tool__grid">
    <!-- Left: drop zone + file list -->
    <div class="tool__main">
      <div class="drop" data-drop tabindex="0" role="button">
        <svg class="drop__icon" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" focusable="false">
          <rect x="6" y="9" width="36" height="30" rx="5" fill="none" stroke="currentColor" stroke-width="3" />
          <circle cx="17" cy="20" r="3.5" fill="currentColor" />
          <path d="M8 35l10-9 7 6 6-5 9 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="drop__title" data-drop-title>{t(lang, 'tool.drop.title')}</p>
        <p class="drop__or">{t(lang, 'tool.drop.or')}</p>
        <label class="btn drop__button">
          <span data-choose-label>{t(lang, 'tool.drop.choose')}</span>
          <input type="file" accept="image/*" multiple hidden data-file-input />
        </label>
        <p class="drop__hint">{t(lang, 'tool.drop.paste')}</p>
        <p class="drop__hint">{t(lang, 'tool.drop.formats')}</p>
        <p class="drop__privacy">{t(lang, 'tool.drop.privacy')}</p>
      </div>
      <p class="tool__notice" role="alert" data-notice hidden></p>

      <div class="files" data-files hidden>
        <div class="files__head">
          <h2 class="files__title" data-files-title></h2>
          <button type="button" class="link-button" data-clear>{t(lang, 'tool.files.clear')}</button>
        </div>
        <div class="progress" data-progress hidden>
          <div class="progress__bar"><span data-progress-bar></span></div>
          <p class="progress__text" data-progress-text></p>
        </div>

        <!-- Shown once results exist: choose the download format and get everything as one ZIP -->
        <div class="results-bar" data-results-bar hidden>
          <div class="field results-bar__format">
            <label for="opt-saveas">{t(lang, 'tool.actions.saveAs')}</label>
            <select id="opt-saveas" data-saveas>
              <option value="">{t(lang, 'tool.actions.sameAsResized')}</option>
              <option value="jpeg">JPG</option>
              <option value="png">PNG</option>
              <option value="webp">WebP</option>
            </select>
          </div>
          <button type="button" class="btn btn--accent" data-download-all hidden>{t(lang, 'tool.actions.downloadAll')}</button>
        </div>

        <ul class="files__list" data-list></ul>
      </div>
    </div>

    <!-- Right: options -->
    <form class="options card" data-options novalidate>
      <h2 class="options__title">{t(lang, 'tool.options.title')}</h2>

      <div class="field">
        <label for="opt-preset">{t(lang, 'tool.options.preset')}</label>
        <select id="opt-preset" data-preset>
          <option value="">{t(lang, 'tool.options.presetNone')}</option>
          {
            groups.map((g) => (
              <optgroup label={g.title}>
                {g.presets.map(({ preset: p, label }) => (
                  <option value={p.id}>{label}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
        <p class="field__note" data-preset-hint hidden>{t(lang, 'tool.options.presetHint')}</p>
      </div>

      <fieldset class="field segmented">
        <legend>{t(lang, 'tool.options.resizeBy')}</legend>
        <label><input type="radio" name="mode" value="dimensions" checked data-mode /><span>{t(lang, 'tool.options.modeDimensions')}</span></label>
        <label><input type="radio" name="mode" value="percent" data-mode /><span>{t(lang, 'tool.options.modePercent')}</span></label>
        <label><input type="radio" name="mode" value="keep" data-mode /><span>{t(lang, 'tool.options.modeKeep')}</span></label>
      </fieldset>

      <div data-panel="dimensions" class="panel">
        <div class="row">
          <div class="field">
            <label for="opt-width">{t(lang, 'tool.options.width')}</label>
            <input id="opt-width" type="number" inputmode="decimal" min="0" step="any" data-width />
          </div>
          <div class="field">
            <label for="opt-height">{t(lang, 'tool.options.height')}</label>
            <input id="opt-height" type="number" inputmode="decimal" min="0" step="any" data-height />
          </div>
          <div class="field field--unit">
            <label for="opt-unit">{t(lang, 'tool.options.unit')}</label>
            <select id="opt-unit" data-unit>
              <option value="px">px</option>
              <option value="cm">cm</option>
              <option value="mm">mm</option>
              <option value="in">in</option>
            </select>
          </div>
        </div>
        <div class="field" data-dpi-field hidden>
          <label for="opt-dpi">{t(lang, 'tool.options.dpi')}</label>
          <input id="opt-dpi" type="number" inputmode="numeric" min="30" max="1200" value="300" data-dpi />
        </div>
        <label class="check"><input type="checkbox" checked data-lock /><span>{t(lang, 'tool.options.lock')}</span></label>
        <div class="field" data-fit-field hidden>
          <label for="opt-fit">{t(lang, 'tool.options.fit')}</label>
          <select id="opt-fit" data-fit>
            <option value="fit">{t(lang, 'tool.options.fitFit')}</option>
            <option value="crop">{t(lang, 'tool.options.fitCrop')}</option>
            <option value="stretch">{t(lang, 'tool.options.fitStretch')}</option>
          </select>
        </div>
      </div>

      <div class="field" data-panel="percent" hidden>
        <label for="opt-percent">{t(lang, 'tool.options.percent')}</label>
        <input id="opt-percent" type="number" inputmode="decimal" min="1" max="1000" value="50" data-percent />
      </div>

      <div class="field">
        <label for="opt-format">{t(lang, 'tool.options.format')}</label>
        <select id="opt-format" data-format>
          <option value="original">{t(lang, 'tool.options.formatOriginal')}</option>
          <option value="jpeg">JPG</option>
          <option value="png">PNG</option>
          <option value="webp">WebP</option>
        </select>
        <p class="field__note" data-png-note hidden>{t(lang, 'tool.options.pngNote')}</p>
      </div>

      <div class="field" data-quality-field>
        <label for="opt-quality">{t(lang, 'tool.options.quality')}: <output data-quality-out>85</output></label>
        <input id="opt-quality" type="range" min="10" max="100" value="85" data-quality />
        <p class="field__note">{t(lang, 'tool.options.qualityNote')}</p>
      </div>

      <div class="field">
        <label class="check"><input type="checkbox" data-target-toggle /><span>{t(lang, 'tool.options.target')}</span></label>
        <div class="row row--target" data-target-row hidden>
          <input type="number" inputmode="decimal" min="1" step="any" value="100" aria-label={t(lang, 'tool.options.targetValue')} data-target-value />
          <select aria-label={t(lang, 'tool.options.unit')} data-target-unit>
            <option value="KB">KB</option>
            <option value="MB">MB</option>
          </select>
        </div>
        <p class="field__note" data-target-note hidden>{t(lang, 'tool.options.targetNote')}</p>
      </div>

      <div class="actions" data-actions>
        <button type="submit" class="btn btn--big" data-run disabled>{t(lang, 'tool.actions.resize')}</button>
        <button type="button" class="btn btn--ghost" data-cancel hidden>{t(lang, 'tool.actions.cancel')}</button>
      </div>
    </form>
  </div>

  <div class="visually-hidden" aria-live="polite" data-live></div>

  <template data-item-template>
    <li class="item" data-item>
      <div class="item__thumb"><img alt="" width="72" height="72" decoding="async" /></div>
      <div class="item__info">
        <p class="item__name" data-name></p>
        <p class="item__meta" data-meta></p>
        <p class="item__error" data-error hidden></p>
      </div>
      <div class="item__side">
        <span class="item__status" data-status></span>
        <button type="button" class="btn btn--small" data-download hidden>{t(lang, 'tool.actions.download')}</button>
        <button type="button" class="icon-button" data-remove>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" /></svg>
        </button>
      </div>
    </li>
  </template>

  <script type="application/json" data-tool-data set:html={JSON.stringify(clientData)} />
</section>

<script>
  import { initTool } from './tool-client';
  document.querySelectorAll<HTMLElement>('[data-tool]').forEach((root) => initTool(root));
</script>

<style>
  .tool__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .tool__main,
  .options {
    min-width: 0;
  }
  /* Two columns whenever the content column is wide enough (not just when the window is) */
  @container page (min-width: 44rem) {
    .tool__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 1fr);
    }
    /* The drop zone and the file list stay in view while the (taller) options column scrolls, so there
       is no big empty area next to the options. A long file list scrolls inside this column. */
    .tool__main {
      position: sticky;
      top: calc(var(--header-h) + var(--space-3));
      max-height: calc(100dvh - var(--header-h) - var(--space-5));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      /* room for focus rings, which overflow:auto would otherwise clip */
      padding: 4px;
      margin: -4px;
    }
  }
  /* Narrow screens: the file list's per-row buttons go under the name */
  @container page (max-width: 36rem) {
    .item {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .item__side {
      grid-column: 1 / -1;
      justify-content: space-between;
    }
  }

  /* Drop zone */
  .drop {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-3);
    min-height: 24rem;
    padding: var(--space-6) var(--space-4);
    text-align: center;
    background: var(--surface);
    border: 3px dashed color-mix(in srgb, var(--brand) 55%, var(--border-strong));
    border-radius: var(--radius-lg);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .drop:hover,
  .drop.is-over {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .drop__icon {
    color: var(--brand);
    padding: var(--space-3);
    box-sizing: content-box;
    background: var(--brand-soft);
    border-radius: var(--radius-md);
  }
  .drop__title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.25;
  }
  .drop__or {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .drop__button {
    cursor: pointer;
    min-height: 4rem;
    /* padding shrinks on narrow screens and long translations wrap instead of overflowing */
    padding: var(--space-2) clamp(var(--space-4), 8vw, var(--space-7));
    max-width: 100%;
    text-align: center;
    line-height: 1.25;
    font-size: var(--step-1);
    font-weight: 800;
    border-radius: var(--radius-sm);
  }
  .drop__hint,
  .drop__privacy {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .drop__privacy {
    color: var(--success-strong);
    font-weight: 700;
  }
  [data-tool].has-files .drop {
    min-height: 0;
    padding-block: var(--space-5);
  }
  [data-tool].has-files .drop__icon,
  [data-tool].has-files .drop__hint,
  [data-tool].has-files .drop__or {
    display: none;
  }

  .tool__notice {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--danger-soft);
    border-radius: var(--radius-md);
    color: var(--text);
    font-weight: 600;
  }

  /* File list */
  .files {
    margin-top: var(--space-5);
  }
  .files__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .files__title {
    font-size: var(--step-2);
    margin: 0;
  }
  .link-button {
    background: none;
    border: 0;
    padding: var(--space-3);
    color: var(--brand);
    font-weight: 700;
    font-size: var(--step-0);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .progress {
    margin: var(--space-3) 0;
  }
  .progress__bar {
    height: 0.75rem;
    background: var(--surface-2);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .progress__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--brand);
    transition: width 0.2s ease;
  }
  .progress__text {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .results-bar__format {
    flex: 1 1 14rem;
  }

  .files__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .item__thumb {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    overflow: hidden;
  }
  .item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .item__name {
    margin: 0;
    font-weight: 700;
    font-size: var(--step-0);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: start;
  }
  .item__meta,
  .item__error {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .item__error {
    color: var(--danger);
    font-weight: 600;
  }
  .item__side {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .item__status {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
  }
  .item[data-state='done'] .item__status {
    color: var(--success-strong);
  }
  .item[data-state='error'] .item__status {
    color: var(--danger);
  }
  .btn--small {
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    font-size: var(--step--1);
  }
  .btn--big {
    min-height: 3.75rem;
    font-size: var(--step-1);
    font-weight: 800;
  }
  .btn--accent {
    background: var(--success-strong);
    color: var(--on-success);
  }
  .btn--accent:hover {
    background: var(--success-strong);
    filter: brightness(0.92);
    color: var(--on-success);
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .icon-button:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  /* Options */
  .options {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .options__title {
    margin: 0;
    font-size: var(--step-2);
  }
  .panel {
    display: grid;
    gap: var(--space-4);
  }
  .field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .field label,
  .field legend {
    font-size: var(--step-0);
    font-weight: 700;
    padding: 0;
  }
  .field__note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .row--target {
    grid-template-columns: minmax(0, 1fr) 7rem;
  }
  .options :global(input[type='number']),
  .options :global(select),
  .results-bar :global(select) {
    width: 100%;
    min-height: var(--control-h);
    padding: 0 var(--space-3);
    background: var(--surface);
    color: var(--text);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--step-0);
  }
  .options :global(input[type='number']):focus,
  .options :global(select):focus,
  .results-bar :global(select):focus {
    border-color: var(--brand);
  }
  .options :global(input[type='range']) {
    width: 100%;
    height: 2rem;
    accent-color: var(--brand);
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--step-0);
    font-weight: 650;
    cursor: pointer;
    min-height: 2.75rem;
  }
  .check input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    accent-color: var(--brand);
  }
  .segmented {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .segmented legend {
    grid-column: 1 / -1;
    margin-bottom: var(--space-1);
  }
  .segmented label {
    position: relative;
    display: block;
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .segmented span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-h);
    padding: var(--space-1) var(--space-2);
    text-align: center;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.2;
    background: var(--surface);
  }
  /* Selected option: peach fill with an orange border, like the reference design */
  .segmented input:checked + span {
    background: var(--brand-soft);
    border-color: var(--brand);
    box-shadow: inset 0 0 0 1px var(--brand);
    color: var(--text);
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .actions {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }
  /* Phones: keep the main button within reach while scrolling through options and files */
  @media (max-width: 47.99rem) {
    .actions {
      position: sticky;
      bottom: 0;
      padding-block: var(--space-3);
      background: linear-gradient(to top, var(--surface) 75%, transparent);
    }
  }
  .actions .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
