---
import { PRESET_GROUPS, presetLabel } from '../../data/presets';
import { subtree } from '../../i18n';
import { t } from '../../i18n';
import { safeJson } from '../../i18n/safe-json';

interface Props {
  lang: string;
  /** Preset id to apply on load (used by landing pages such as "resize to 50 KB"). */
  preset?: string;
  /** Format to preselect on load. */
  format?: 'original' | 'jpeg' | 'png' | 'webp';
  /** Unit (and DPI) to preselect, e.g. cm at 300 DPI on the "resize in cm" page. */
  unit?: 'px' | 'cm' | 'mm' | 'in';
  dpi?: number;
  /** Resize mode to preselect (convert/compress pages start on "keep size"). */
  mode?: 'dimensions' | 'percent' | 'keep';
}
const { lang, preset, format = 'original', unit, dpi, mode } = Astro.props;

const words = subtree(lang, 'tool.presets.words') as Record<string, string>;
const groups = PRESET_GROUPS.map((g) => ({
  id: g.id,
  title: t(lang, `tool.presets.groups.${g.id}` as 'tool.presets.groups.social'),
  presets: g.presets.map((p) => ({ preset: p, label: presetLabel(p, words) })),
}));

// Everything the client script needs, in the visitor's language.
const clientData = {
  lang,
  initialPreset: preset ?? '',
  initialFormat: format,
  initialMode: mode ?? '',
  initialUnit: unit ?? '',
  initialDpi: dpi ?? 0,
  text: subtree(lang, 'tool'),
};
---
<section class="tool" data-tool data-view="setup" aria-label={t(lang, 'tool.aria')}>
  <div class="tool__grid" data-setup>
    <!-- Left: drop zone + file list -->
    <div class="tool__main">
      <!-- Mouse users can click anywhere in the zone; keyboard and screen-reader users use the real "Choose" button. -->
      <div class="drop" data-drop>
        <svg class="drop__icon" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" focusable="false">
          <rect x="6" y="9" width="36" height="30" rx="5" fill="none" stroke="currentColor" stroke-width="3" />
          <circle cx="17" cy="20" r="3.5" fill="currentColor" />
          <path d="M8 35l10-9 7 6 6-5 9 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="drop__title" data-drop-title>{t(lang, 'tool.drop.title')}</p>
        <p class="drop__or">{t(lang, 'tool.drop.or')}</p>
        <button type="button" class="btn drop__button" data-choose>{t(lang, 'tool.drop.choose')}</button>
        <input type="file" accept="image/*" multiple hidden data-file-input />
        <p class="drop__hint">{t(lang, 'tool.drop.paste')}</p>
        <p class="drop__hint">{t(lang, 'tool.drop.formats')}</p>
        <p class="drop__privacy">{t(lang, 'tool.drop.privacy')}</p>
      </div>
      <p class="tool__notice" role="alert" data-notice hidden></p>
      <noscript><p class="tool__notice">{t(lang, 'tool.noscript')}</p></noscript>

      <div class="files" data-files hidden>
        <div class="files__head">
          <h2 class="files__title" data-files-title></h2>
          <button type="button" class="link-button" data-clear>{t(lang, 'tool.files.clear')}</button>
        </div>
        <ul class="files__list" data-list></ul>
      </div>
    </div>

    <!-- Right: options -->
    <form class="options card" data-options novalidate>
      <h2 class="options__title">{t(lang, 'tool.options.title')}</h2>

      <div class="field">
        <label for="opt-preset">{t(lang, 'tool.options.preset')}</label>
        <select id="opt-preset" data-preset>
          <option value="">{t(lang, 'tool.options.presetNone')}</option>
          {
            groups.map((g) => (
              <optgroup label={g.title}>
                {g.presets.map(({ preset: p, label }) => (
                  <option value={p.id}>{label}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
        <p class="field__note" data-preset-hint hidden>{t(lang, 'tool.options.presetHint')}</p>
      </div>

      <fieldset class="field segmented">
        <legend>{t(lang, 'tool.options.resizeBy')}</legend>
        <label><input type="radio" name="mode" value="dimensions" checked data-mode /><span>{t(lang, 'tool.options.modeDimensions')}</span></label>
        <label><input type="radio" name="mode" value="percent" data-mode /><span>{t(lang, 'tool.options.modePercent')}</span></label>
        <label><input type="radio" name="mode" value="keep" data-mode /><span>{t(lang, 'tool.options.modeKeep')}</span></label>
      </fieldset>

      <div data-panel="dimensions" class="panel">
        <div class="row">
          <div class="field">
            <label for="opt-width">{t(lang, 'tool.options.width')}</label>
            <input id="opt-width" type="number" inputmode="decimal" min="0" step="any" data-width />
          </div>
          <div class="field">
            <label for="opt-height">{t(lang, 'tool.options.height')}</label>
            <input id="opt-height" type="number" inputmode="decimal" min="0" step="any" data-height />
          </div>
          <div class="field field--unit">
            <label for="opt-unit">{t(lang, 'tool.options.unit')}</label>
            <select id="opt-unit" data-unit>
              <option value="px">px</option>
              <option value="cm">cm</option>
              <option value="mm">mm</option>
              <option value="in">in</option>
            </select>
          </div>
        </div>
        <div class="field" data-dpi-field hidden>
          <label for="opt-dpi">{t(lang, 'tool.options.dpi')}</label>
          <input id="opt-dpi" type="number" inputmode="numeric" min="30" max="1200" value="300" data-dpi />
        </div>
        <label class="check"><input type="checkbox" checked data-lock /><span>{t(lang, 'tool.options.lock')}</span></label>
        <div class="field" data-fit-field hidden>
          <label for="opt-fit">{t(lang, 'tool.options.fit')}</label>
          <select id="opt-fit" data-fit>
            <option value="fit">{t(lang, 'tool.options.fitFit')}</option>
            <option value="crop">{t(lang, 'tool.options.fitCrop')}</option>
            <option value="stretch">{t(lang, 'tool.options.fitStretch')}</option>
          </select>
        </div>
      </div>

      <div class="field" data-panel="percent" hidden>
        <label for="opt-percent">{t(lang, 'tool.options.percent')}</label>
        <input id="opt-percent" type="number" inputmode="decimal" min="1" max="1000" value="50" data-percent />
      </div>

      <div class="field">
        <label for="opt-format">{t(lang, 'tool.options.format')}</label>
        <select id="opt-format" data-format>
          <option value="original">{t(lang, 'tool.options.formatOriginal')}</option>
          <option value="jpeg">JPG</option>
          <option value="png">PNG</option>
          <option value="webp">WebP</option>
        </select>
        <p class="field__note" data-png-note hidden>{t(lang, 'tool.options.pngNote')}</p>
      </div>

      <div class="field" data-quality-field>
        <label for="opt-quality">{t(lang, 'tool.options.quality')}: <output data-quality-out>85</output></label>
        <input id="opt-quality" type="range" min="10" max="100" value="85" data-quality />
        <p class="field__note">{t(lang, 'tool.options.qualityNote')}</p>
      </div>

      <div class="field">
        <label class="check"><input type="checkbox" data-target-toggle /><span>{t(lang, 'tool.options.target')}</span></label>
        <div class="row row--target" data-target-row hidden>
          <input type="number" inputmode="decimal" min="1" step="any" value="100" aria-label={t(lang, 'tool.options.targetValue')} data-target-value />
          <select aria-label={t(lang, 'tool.options.unit')} data-target-unit>
            <option value="KB">KB</option>
            <option value="MB">MB</option>
          </select>
        </div>
        <p class="field__note" data-target-note hidden>{t(lang, 'tool.options.targetNote')}</p>
      </div>

      <p class="field__error" role="alert" data-run-error hidden></p>

      <div class="actions" data-actions>
        <button type="submit" class="btn btn--big" data-run disabled>{t(lang, 'tool.actions.resize')}</button>
      </div>
    </form>
  </div>

  <!-- Results view: shown after "Resize images" is pressed. Full width, one card per image. -->
  <div class="results" data-results hidden>
    <div class="results__head">
      <h2 class="results__title" data-results-title tabindex="-1">{t(lang, 'tool.results.title')}</h2>
      <p class="results__sub" data-results-sub></p>
      <div class="progress" data-progress>
        <div class="progress__bar" role="progressbar" aria-label={t(lang, 'tool.results.progress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-meter>
          <span data-progress-bar></span>
        </div>
      </div>
      <p class="results__total" data-results-total hidden></p>
    </div>

    <div class="results__bar" data-results-bar>
      <div class="results__bar-group">
        <button type="button" class="btn btn--ghost" data-back>{t(lang, 'tool.results.back')}</button>
        <button type="button" class="btn btn--ghost" data-start-over>{t(lang, 'tool.results.startOver')}</button>
        <button type="button" class="btn btn--ghost" data-cancel hidden>{t(lang, 'tool.actions.cancel')}</button>
      </div>
      <div class="results__bar-group results__bar-group--end" data-download-group hidden>
        <div class="field results__format">
          <label for="opt-saveas">{t(lang, 'tool.actions.saveAs')}</label>
          <select id="opt-saveas" data-saveas>
            <option value="">{t(lang, 'tool.actions.sameAsResized')}</option>
            <option value="jpeg">JPG</option>
            <option value="png">PNG</option>
            <option value="webp">WebP</option>
          </select>
        </div>
        <button type="button" class="btn btn--accent" data-download-all hidden>{t(lang, 'tool.actions.downloadAll')}</button>
      </div>
    </div>

    <p class="results__alert" role="alert" data-results-alert hidden></p>
    <ul class="results__grid" data-grid></ul>
  </div>

  <div class="visually-hidden" aria-live="polite" data-live></div>

  <!-- A row in the "your images" list, before resizing -->
  <template data-row-template>
    <li class="item" data-row>
      <div class="item__thumb"><img alt="" width="72" height="72" decoding="async" /></div>
      <div class="item__info">
        <p class="item__name" data-name></p>
        <p class="item__meta" data-meta></p>
      </div>
      <button type="button" class="icon-button" data-remove>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" /></svg>
      </button>
    </li>
  </template>

  <!-- A card in the results view, after "Resize images" -->
  <template data-card-template>
    <li class="rcard" data-item>
      <div class="rcard__media">
        <img alt="" decoding="async" />
        <span class="rcard__status" data-status></span>
        <span class="rcard__badge" data-badge hidden></span>
      </div>
      <div class="rcard__body">
        <p class="rcard__name" data-name></p>
        <p class="rcard__dims" data-dims></p>
        <dl class="rcard__sizes" data-sizes hidden>
          <div>
            <dt>{t(lang, 'tool.results.original')}</dt>
            <dd data-size-before></dd>
          </div>
          <div>
            <dt>{t(lang, 'tool.results.resized')}</dt>
            <dd data-size-after></dd>
          </div>
        </dl>
        <p class="rcard__meta" data-meta hidden></p>
        <p class="rcard__error" data-error hidden></p>
      </div>
      <div class="rcard__actions">
        <button type="button" class="btn rcard__download" data-download hidden>{t(lang, 'tool.actions.download')}</button>
        <button type="button" class="icon-button" data-remove>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" /></svg>
        </button>
      </div>
    </li>
  </template>

  <script type="application/json" data-tool-data set:html={safeJson(clientData)} />
</section>

<script>
  import { initTool } from './tool-client';
  document.querySelectorAll<HTMLElement>('[data-tool]').forEach((root) => initTool(root));
</script>

<style>
  .tool__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .tool__main,
  .options {
    min-width: 0;
  }
  /* Two columns whenever the content column is wide enough (not just when the window is) */
  @container page (min-width: 40rem) {
    .tool__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 1fr);
    }
    /* The drop zone and the file list stay in view while the (taller) options column scrolls, so there
       is no big empty area next to the options. A long file list scrolls inside this column. */
    .tool__main {
      position: sticky;
      top: calc(var(--header-h) + var(--space-3));
      max-height: calc(100dvh - var(--header-h) - var(--space-5));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      /* room for focus rings, which overflow:auto would otherwise clip */
      padding: 4px;
      margin: -4px;
    }
  }

  /* Drop zone */
  .drop {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-3);
    min-height: 24rem;
    padding: var(--space-6) var(--space-4);
    text-align: center;
    background: var(--surface);
    border: 3px dashed color-mix(in srgb, var(--brand) 55%, var(--border-strong));
    border-radius: var(--radius-lg);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .drop:hover,
  .drop.is-over {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .drop__icon {
    color: var(--brand);
    padding: var(--space-3);
    box-sizing: content-box;
    background: var(--brand-soft);
    border-radius: var(--radius-md);
  }
  .drop__title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.25;
  }
  .drop__or {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .drop__button {
    cursor: pointer;
    min-height: 4rem;
    /* padding shrinks on narrow screens and long translations wrap instead of overflowing */
    padding: var(--space-2) clamp(var(--space-4), 8vw, var(--space-7));
    max-width: 100%;
    text-align: center;
    line-height: 1.25;
    font-size: var(--step-1);
    font-weight: 800;
    border-radius: var(--radius-sm);
  }
  .drop__hint,
  .drop__privacy {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .drop__privacy {
    color: var(--success-strong);
    font-weight: 700;
  }
  [data-tool].has-files .drop {
    min-height: 0;
    padding-block: var(--space-5);
  }
  [data-tool].has-files .drop__icon,
  [data-tool].has-files .drop__hint,
  [data-tool].has-files .drop__or {
    display: none;
  }

  .tool__notice {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--danger-soft);
    border-radius: var(--radius-md);
    color: var(--text);
    font-weight: 600;
  }

  /* File list */
  .files {
    margin-top: var(--space-5);
  }
  .files__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .files__title {
    font-size: var(--step-2);
    margin: 0;
  }
  .link-button {
    background: none;
    border: 0;
    padding: var(--space-3);
    color: var(--brand);
    font-weight: 700;
    font-size: var(--step-0);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .progress {
    margin: var(--space-3) 0;
  }
  .progress__bar {
    height: 0.75rem;
    background: var(--surface-2);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .progress__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--brand);
    transition: width 0.2s ease;
  }

  .files__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  /* A row in the list of added images (before resizing) */
  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .item__thumb {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    overflow: hidden;
  }
  .item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .item__name {
    margin: 0;
    font-weight: 700;
    font-size: var(--step-0);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    text-align: start;
  }
  .item__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------------------------------------
     Results view (after "Resize images"): full width, header with progress, toolbar, card grid
     ------------------------------------------------------------------------------------------ */
  .results {
    display: grid;
    gap: var(--space-5);
  }
  .results__head {
    display: grid;
    gap: var(--space-2);
  }
  .results__title {
    margin: 0;
    font-size: var(--step-3);
  }
  .results__title:focus {
    outline: none;
  }
  .results__sub {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 650;
    color: var(--text-muted);
  }
  .results__total {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--success-soft);
    border-radius: var(--radius-md);
    font-size: var(--step-1);
    font-weight: 750;
    color: var(--text);
  }
  .progress {
    margin: var(--space-2) 0 0;
  }
  .results__alert {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--danger-soft);
    border-radius: var(--radius-md);
    font-weight: 650;
  }

  /* Toolbar: stays reachable while scrolling through many images */
  .results__bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .results__bar-group {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }
  .results__bar .btn {
    min-height: var(--control-h);
    padding-inline: var(--space-5);
  }
  .results__format {
    min-width: 12rem;
  }
  @container page (max-width: 40rem) {
    .results__bar {
      position: static;
    }
    .results__bar-group,
    .results__bar-group .btn,
    .results__format {
      flex: 1 1 100%;
    }
  }

  /* Card grid: 1 column on phones, 2-3 on larger screens */
  .results__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .rcard {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .rcard[data-state='error'] {
    border-color: var(--danger);
  }
  .rcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    /* light checkerboard so transparent images are easy to see */
    background:
      conic-gradient(var(--surface-2) 25%, var(--surface) 0 50%, var(--surface-2) 0 75%, var(--surface) 0) 0 0 /
      1.25rem 1.25rem;
  }
  .rcard__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .rcard__status {
    position: absolute;
    inset-inline: var(--space-3);
    bottom: var(--space-3);
    justify-self: center;
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 700;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .rcard[data-state='done'] .rcard__status {
    display: none;
  }
  .rcard[data-state='error'] .rcard__status {
    color: var(--danger);
  }
  .rcard[data-state='processing'] .rcard__status::before {
    content: '';
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-inline-end: 0.5em;
    vertical-align: -0.1em;
    border: 2px solid var(--border-strong);
    border-top-color: var(--brand);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .rcard__badge {
    position: absolute;
    top: var(--space-3);
    inset-inline-end: var(--space-3);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
    background: var(--success-strong);
    color: var(--on-success);
    font-size: var(--step--1);
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }
  .rcard__badge--larger {
    background: var(--warning);
    color: #fff;
  }
  .rcard__body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-2);
    min-width: 0;
  }
  .rcard__name {
    margin: 0;
    font-weight: 750;
