---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolNav from '../components/ToolNav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import LanguageSuggest from '../components/LanguageSuggest.astro';
import { FONT_STYLESHEETS } from '../i18n/languages';
import { ADSENSE, ADS_LIVE } from '../config/site';
import { alternates, getLanguage, localizedPath, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Language code from src/i18n/languages.ts. */
  lang: string;
  /** Page path WITHOUT a language prefix, e.g. "/" or "/resize-image-to-50kb/". */
  path?: string;
  /** Show the right-hand ad rail / inline ad slot (default true). */
  ads?: boolean;
  /**
   * Where the phone/tablet ad goes: 'end' = after the page content (default), 'manual' = the page places
   * <AdSlot variant="inline"> itself (tool pages put it after the "how to" steps, well away from the buttons).
   */
  inlineAd?: 'end' | 'manual';
  /** Show the strip of tool links under the header (default true). */
  toolNav?: boolean;
  /** Error pages (404): no canonical link, no hreflang alternates and no og:url - they are served for any URL. */
  plain?: boolean;
}
const { title, description, lang, path = '/', ads = true, inlineAd = 'end', toolNav = true, plain = false } = Astro.props;
const language = getLanguage(lang);
const site = Astro.site!;
const canonical = new URL(localizedPath(lang, path), site).href;
const fontSheets = FONT_STYLESHEETS[language.font];
const versions = alternates(path);
// The AdSense code is only needed where ads can show. Before any ad unit exists it is loaded on the home pages
// alone, which is where Google's site check looks; every other page stays free of third-party code.
const loadAdScript = Boolean(ADSENSE.client) && ads && (ADS_LIVE || path === '/');
---
<!doctype html>
<html lang={language.htmlLang} dir={language.dir} data-lang={language.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!plain && <link rel="canonical" href={canonical} />}
    {
      !plain &&
        versions.map(({ language: l, href }) => (
          <link rel="alternate" hreflang={l.htmlLang} href={new URL(href, site).href} />
        ))
    }
    {!plain && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', path), site).href} />}
    <meta name="theme-color" content="#fff4e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b100b" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FreeResizeImageOnline" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!plain && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={language.htmlLang.replace('-', '_')} />
    <meta property="og:image" content={new URL('/og-image.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    {fontSheets.map((name) => <link rel="stylesheet" href={`/fonts/${name}/index.css`} />)}

    <!-- Structured data and other page-specific head tags -->
    <slot name="head" />

    <!-- Google AdSense: account ownership (meta tag) and the standard code snippet in <head>.
         The snippet is on pages that show ads. Keep "Auto ads" switched OFF in AdSense:
         ad placement here is manual (one clearly labelled box). -->
    {ADSENSE.client && <meta name="google-adsense-account" content={ADSENSE.client} />}
    {
      loadAdScript && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}
          crossorigin="anonymous"
        ></script>
      )
    }

    <!-- Apply the saved/system theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skipToContent')}</a>
    <Header lang={lang} path={path} />
    {toolNav && <ToolNav lang={lang} path={path} />}
    <LanguageSuggest lang={lang} path={path} />

    <div class="page container">
      <main id="main" class="page__main">
        <Breadcrumbs lang={lang} path={path} />
        <slot />
        {ads && inlineAd === 'end' && (
          <div class="page__inline-ad">
            <AdSlot variant="inline" lang={lang} />
          </div>
        )}
      </main>
      {
        ads && (
          <div class="page__rail">
            <AdSlot variant="rail" lang={lang} />
          </div>
        )
      }
    </div>

    <Footer lang={lang} />

    {
      loadAdScript && (
        <script is:inline>
          {`
          // Fill only the ad box that is visible at this screen size (an ad can't be sized inside a hidden box).
          // Boxes only contain an <ins> once ad unit ids are set in src/config/site.ts.
          (function () {
            function fill() {
              var boxes = document.querySelectorAll('[data-ad-slot] ins.adsbygoogle');
              window.adsbygoogle = window.adsbygoogle || [];
              Array.prototype.forEach.call(boxes, function (ins) {
                if (ins.offsetParent === null || ins.getAttribute('data-adsbygoogle-status')) return;
                try { window.adsbygoogle.push({}); } catch (e) {}
              });
            }
            if (document.readyState === 'complete') fill(); else window.addEventListener('load', fill, { once: true });
            // The other ad box becomes visible when the window crosses the rail breakpoint (rotation, resize): fill it then.
            if (window.matchMedia) window.matchMedia('(min-width: 75rem)').addEventListener('change', fill);
          })();
          `}
        </script>
      )
    }
  </body>
</html>
