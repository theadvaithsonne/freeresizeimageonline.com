---
import Layout from '../../layouts/Layout.astro';
import ResizerTool from '../../components/tool/ResizerTool.astro';
import Sections from '../../components/content/Sections.astro';
import { getLanguage, languageStaticPaths, list, localizedPath, t } from '../../i18n';
import { safeJson } from '../../i18n/safe-json';
import { SITE } from '../../config/site';
import { TOOL_ROUTES } from '../../data/routes';
import type { MessageKey } from '../../i18n';

export function getStaticPaths() {
  return languageStaticPaths();
}

const { lang } = Astro.props;
const steps = list<{ title: string; text: string }>(lang, 'home.how.steps');
const features = list<{ title: string; text: string }>(lang, 'home.why.items');
const faq = list<{ q: string; a: string }>(lang, 'home.faq.items');

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
// "Popular tasks": a card for every other tool page (name + one line), so visitors and search engines find them at once.
const popular = TOOL_ROUTES.filter((r) => r.key !== 'home').map((r) => ({
  href: localizedPath(lang, r.path),
  title: t(lang, `nav.${r.key}` as MessageKey),
  text: t(lang, `${r.key}.blurb` as MessageKey),
}));
const localName = t(lang, 'brand.name');
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  // the name in the page's own alphabet, for languages that do not use Latin letters
  alternateName: localName !== SITE.name ? localName : undefined,
  url: SITE.url,
  inLanguage: getLanguage(lang).htmlLang,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: new URL('/icon-512.png', SITE.url).href },
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  url: new URL(localizedPath(lang, '/'), SITE.url).href,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern web browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: t(lang, 'home.description'),
  inLanguage: getLanguage(lang).htmlLang,
};
---
<Layout title={t(lang, 'home.title')} description={t(lang, 'home.description')} lang={lang} path="/" inlineAd="manual">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJson(siteLd)} />
    <script type="application/ld+json" set:html={safeJson(appLd)} />
    <script type="application/ld+json" set:html={safeJson(faqLd)} />
  </Fragment>

  <h1>{t(lang, 'home.h1')}</h1>
  <ul class="badges">
    <li class="badge">{t(lang, 'badges.free')}</li>
    <li class="badge">{t(lang, 'badges.unlimited')}</li>
    <li class="badge">{t(lang, 'badges.noLogin')}</li>
    <li class="badge">{t(lang, 'badges.private')}</li>
  </ul>

  <ResizerTool lang={lang} />

  <section class="popular" aria-labelledby="popular-title">
    <h2 id="popular-title">{t(lang, 'home.popular.title')}</h2>
    <ul class="popular__grid">
      {
        popular.map((p) => (
          <li>
            <a class="popular__card" href={p.href}>
              <span class="popular__name">{p.title}</span>
              <span class="popular__text">{p.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Sections
    lang={lang}
    stepsTitle={t(lang, 'home.how.title')}
    steps={steps}
    faqTitle={t(lang, 'common.faqTitle')}
    faq={faq}
    currentKey="home"
    inlineAd
  >
    <section class="block" aria-labelledby="why-title">
      <h2 id="why-title">{t(lang, 'home.why.title')}</h2>
      <div class="features">
        {
          features.map((f) => (
            <div class="feature card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </Sections>
</Layout>

<style>
  .popular {
    margin-top: var(--space-7);
  }
  .popular h2 {
    font-size: var(--step-2);
  }
  .popular__grid {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
  }
  .popular__card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    padding-inline-end: var(--space-7);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }
  .popular__card::after {
    content: '→';
    position: absolute;
    inset-inline-end: var(--space-4);
    top: var(--space-4);
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--brand);
  }
  :global([dir='rtl']) .popular__card::after {
    content: '←';
  }
  .popular__card:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .popular__name {
    font-weight: 750;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .popular__text {
    color: var(--text-muted);
    line-height: 1.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .popular__card {
      transition: none;
    }
    .popular__card:hover {
      transform: none;
    }
  }
  .block h2 {
    font-size: var(--step-2);
  }
  .features {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }
  .feature {
    padding: var(--space-5);
  }
  .feature h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }
  .feature p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
