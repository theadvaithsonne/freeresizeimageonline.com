---
import ToolPage from '../../components/content/ToolPage.astro';
import { languageStaticPaths } from '../../i18n';

export function getStaticPaths() {
  return languageStaticPaths();
}
const { lang } = Astro.props;
---
<ToolPage lang={lang} pageKey="youtubeSize" preset="yt-thumb" table="social" tableOnly={['YouTube']} />
