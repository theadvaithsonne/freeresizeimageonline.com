---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Free Resize Image Online - Resize Photos, No Signup, Unlimited"
  description="Resize, compress and convert images free. No login, no limits, and your photos never leave your device."
  lang="en"
  path="/"
>
  <h1>Resize images online, free</h1>
  <ul class="badges" aria-label="Highlights">
    <li class="badge">Free</li>
    <li class="badge">Unlimited</li>
    <li class="badge">No login</li>
    <li class="badge">Private: stays on your device</li>
  </ul>

  <!-- Layout preview only: the real tool replaces this in Steps 4-5. -->
  <section class="card layout-preview" aria-label="Tool placeholder">
    <p>The resizer tool is coming soon.</p>
    <p class="layout-preview__muted">Design system and responsive shell are ready (Step 2).</p>
    <a class="btn" href="/">Choose a file</a>
    <a class="btn btn--ghost" href="/">Secondary action</a>
  </section>
</Layout>

<style>
  .layout-preview {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    min-height: 22rem;
    place-content: center;
    padding: var(--space-6);
    border-style: dashed;
    border-width: 2px;
    text-align: start;
  }
  .layout-preview p {
    margin: 0;
  }
  .layout-preview__muted {
    color: var(--text-muted);
  }
</style>
